\subsection{Execute Loop}

The main execution loop runs instructions until the cycle budget is exhausted.
Each iteration fetches one opcode, increments the R register, and dispatches.

<<z80 execute loop>>=
int Z80::execute(int cycles_to_run)
{
    m_cycles_remaining = cycles_to_run;
    m_cycles_consumed = 0;

    while (m_cycles_remaining > 0) {
        // Process EI delay (interrupts enabled after one instruction)
        bool was_ei_pending = m_ei_pending;
        m_ei_pending = false;

        // Handle pending interrupts (unless just executed EI)
        if (!was_ei_pending) {
            handle_interrupts();
        }

        if (m_halted) {
            // HALT consumes cycles as NOP (4 T-states each)
            eat(4);
            m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
            continue;
        }

        // Fetch and execute one instruction
        m_prev_q = m_q;  // Save Q from previous instruction for SCF/CCF
        m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
        uint8_t opcode = fetch();
        execute_opcode(opcode);
    }

    return m_cycles_consumed;
}

int Z80::step()
{
    m_cycles_remaining = 100;  // generous budget for one instruction
    m_cycles_consumed = 0;

    if (m_halted) {
        eat(4);
        m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
        m_q = 0;
        return m_cycles_consumed;
    }

    m_prev_q = m_q;  // Save Q from previous instruction for SCF/CCF
    m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
    uint8_t opcode = fetch();
    execute_opcode(opcode);

    return m_cycles_consumed;
}
@

\section{Unprefixed Opcodes}

The Z80's 256 unprefixed opcodes divide into four major blocks:
\begin{itemize}
\item \textbf{0x00--0x3F}: Miscellaneous (loads, inc/dec, rotates, jumps)
\item \textbf{0x40--0x7F}: 8-bit register-to-register loads (and HALT)
\item \textbf{0x80--0xBF}: 8-bit ALU operations
\item \textbf{0xC0--0xFF}: Control flow, stack, I/O, prefixes
\end{itemize}

The LD and ALU blocks are regular enough to decode from the opcode bits.
The other blocks require individual case handling.

<<z80 unprefixed opcodes>>=
void Z80::execute_opcode(uint8_t opcode)
{
    m_q = 0;  // Default: instruction does not modify flags via ALU

    <<unprefixed 0x40-0x7F load block>>
    <<unprefixed 0x80-0xBF ALU block>>
    <<unprefixed 0x00-0x3F misc block>>
    <<unprefixed 0xC0-0xFF control block>>
}
@

\subsection{LD Block (0x40--0x7F)}

This block encodes [[LD dst, src]] where dst = bits 5--3, src = bits 2--0.
The exception is 0x76 which is [[HALT]] instead of [[LD (HL),(HL)]].

Register-to-register loads take 4 T-states. Loads involving [[(HL)]] take
7 T-states (4 for the opcode fetch + 3 for the memory access).

<<unprefixed 0x40-0x7F load block>>=
    if (opcode >= 0x40 && opcode <= 0x7F) {
        if (opcode == 0x76) {
            // HALT
            m_halted = true;
            eat(4);
            return;
        }
        int dst = (opcode >> 3) & 7;
        int src = opcode & 7;
        uint8_t val = read_r8(src);
        write_r8(dst, val);
        // 4 cycles base, +3 if src=(HL), +3 if dst=(HL)
        // (both can't be (HL) since that's HALT)
        eat((src == 6 || dst == 6) ? 7 : 4);
        return;
    }
@

\subsection{ALU Block (0x80--0xBF)}

This block encodes ALU operations: ADD(0), ADC(1), SUB(2), SBC(3),
AND(4), XOR(5), OR(6), CP(7) with the source register in bits 2--0.

Register operations take 4 T-states, (HL) variants take 7.

<<unprefixed 0x80-0xBF ALU block>>=
    if (opcode >= 0x80 && opcode <= 0xBF) {
        int op = (opcode >> 3) & 7;
        int src = opcode & 7;
        uint8_t val = read_r8(src);
        switch (op) {
            case 0: alu_add(val); break;
            case 1: alu_adc(val); break;
            case 2: alu_sub(val); break;
            case 3: alu_sbc(val); break;
            case 4: alu_and(val); break;
            case 5: alu_xor(val); break;
            case 6: alu_or(val);  break;
            case 7: alu_cp(val);  break;
        }
        eat(src == 6 ? 7 : 4);
        return;
    }
@

\subsection{Misc Block (0x00--0x3F)}

This block contains 16-bit loads, inc/dec, rotates, relative jumps, DAA,
CPL, SCF, CCF, and the EX AF,AF' instruction.

<<unprefixed 0x00-0x3F misc block>>=
    if (opcode <= 0x3F) {
        switch (opcode) {
            case 0x00: // NOP
                eat(4);
                return;

            case 0x01: // LD BC,nn
                m_bc.w = fetch16();
                eat(10);
                return;

            case 0x02: // LD (BC),A
                mem_write(m_bc.w, m_af.b.h);
                m_wz.b.l = (m_bc.w + 1) & 0xFF;
                m_wz.b.h = m_af.b.h;
                eat(7);
                return;

            case 0x03: // INC BC
                m_bc.w++;
                eat(6);
                return;

            case 0x04: // INC B
                m_bc.b.h = alu_inc(m_bc.b.h);
                eat(4);
                return;

            case 0x05: // DEC B
                m_bc.b.h = alu_dec(m_bc.b.h);
                eat(4);
                return;

            case 0x06: // LD B,n
                m_bc.b.h = fetch();
                eat(7);
                return;

            case 0x07: { // RLCA
                uint8_t a = m_af.b.h;
                m_af.b.h = (a @<< 1) | (a >> 7);
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) |
                           (m_af.b.h & (YF | XF | CF));
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x08: { // EX AF,AF'
                uint16_t tmp = m_af.w;
                m_af.w = m_af2.w;
                m_af2.w = tmp;
                eat(4);
                return;
            }

            case 0x09: // ADD HL,BC
                alu_add16(m_hl, m_bc.w);
                eat(11);
                return;

            case 0x0A: // LD A,(BC)
                m_af.b.h = mem_read(m_bc.w);
                m_wz.w = m_bc.w + 1;
                eat(7);
                return;

            case 0x0B: // DEC BC
                m_bc.w--;
                eat(6);
                return;

            case 0x0C: // INC C
                m_bc.b.l = alu_inc(m_bc.b.l);
                eat(4);
                return;

            case 0x0D: // DEC C
                m_bc.b.l = alu_dec(m_bc.b.l);
                eat(4);
                return;

            case 0x0E: // LD C,n
                m_bc.b.l = fetch();
                eat(7);
                return;

            case 0x0F: { // RRCA
                uint8_t a = m_af.b.h;
                m_af.b.h = (a >> 1) | (a @<< 7);
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) |
                           (m_af.b.h & (YF | XF)) |
                           (a & CF);
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x10: { // DJNZ e
                int8_t offset = (int8_t)fetch();
                m_bc.b.h--;
                if (m_bc.b.h != 0) {
                    m_pc.w += offset;
                    m_wz.w = m_pc.w;
                    eat(13);
                } else {
                    eat(8);
                }
                return;
            }

            case 0x11: // LD DE,nn
                m_de.w = fetch16();
                eat(10);
                return;

            case 0x12: // LD (DE),A
                mem_write(m_de.w, m_af.b.h);
                m_wz.b.l = (m_de.w + 1) & 0xFF;
                m_wz.b.h = m_af.b.h;
                eat(7);
                return;

            case 0x13: // INC DE
                m_de.w++;
                eat(6);
                return;

            case 0x14: // INC D
                m_de.b.h = alu_inc(m_de.b.h);
                eat(4);
                return;

            case 0x15: // DEC D
                m_de.b.h = alu_dec(m_de.b.h);
                eat(4);
                return;

            case 0x16: // LD D,n
                m_de.b.h = fetch();
                eat(7);
                return;

            case 0x17: { // RLA
                uint8_t a = m_af.b.h;
                uint8_t c = m_af.b.l & CF;
                m_af.b.h = (a << 1) | c;
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) |
                           (m_af.b.h & (YF | XF)) |
                           (a >> 7);
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x18: { // JR e
                int8_t offset = (int8_t)fetch();
                m_pc.w += offset;
                m_wz.w = m_pc.w;
                eat(12);
                return;
            }

            case 0x19: // ADD HL,DE
                alu_add16(m_hl, m_de.w);
                eat(11);
                return;

            case 0x1A: // LD A,(DE)
                m_af.b.h = mem_read(m_de.w);
                m_wz.w = m_de.w + 1;
                eat(7);
                return;

            case 0x1B: // DEC DE
                m_de.w--;
                eat(6);
                return;

            case 0x1C: // INC E
                m_de.b.l = alu_inc(m_de.b.l);
                eat(4);
                return;

            case 0x1D: // DEC E
                m_de.b.l = alu_dec(m_de.b.l);
                eat(4);
                return;

            case 0x1E: // LD E,n
                m_de.b.l = fetch();
                eat(7);
                return;

            case 0x1F: { // RRA
                uint8_t a = m_af.b.h;
                uint8_t c = m_af.b.l & CF;
                m_af.b.h = (a >> 1) | (c @<< 7);
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) |
                           (m_af.b.h & (YF | XF)) |
                           (a & CF);
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x20: { // JR NZ,e
                int8_t offset = (int8_t)fetch();
                if (!(m_af.b.l & ZF)) {
                    m_pc.w += offset;
                    m_wz.w = m_pc.w;
                    eat(12);
                } else {
                    eat(7);
                }
                return;
            }

            case 0x21: // LD HL,nn
                m_hl.w = fetch16();
                eat(10);
                return;

            case 0x22: { // LD (nn),HL
                uint16_t addr = fetch16();
                mem_write(addr, m_hl.b.l);
                mem_write(addr + 1, m_hl.b.h);
                m_wz.w = addr + 1;
                eat(16);
                return;
            }

            case 0x23: // INC HL
                m_hl.w++;
                eat(6);
                return;

            case 0x24: // INC H
                m_hl.b.h = alu_inc(m_hl.b.h);
                eat(4);
                return;

            case 0x25: // DEC H
                m_hl.b.h = alu_dec(m_hl.b.h);
                eat(4);
                return;

            case 0x26: // LD H,n
                m_hl.b.h = fetch();
                eat(7);
                return;

            case 0x27: { // DAA
                uint8_t a = m_af.b.h;
                uint8_t f = m_af.b.l;
                uint8_t correction = 0;
                uint8_t new_c = f & CF;

                if ((a & 0x0F) > 9 || (f & HF)) {
                    correction |= 0x06;
                }
                if (a > 0x99 || (f & CF)) {
                    correction |= 0x60;
                    new_c = CF;
                }

                if (f & NF) {
                    m_af.b.h -= correction;
                } else {
                    m_af.b.h += correction;
                }

                m_af.b.l = szp_table[m_af.b.h] |
                           (f & NF) |
                           new_c |
                           ((a ^ m_af.b.h) & HF);
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x28: { // JR Z,e
                int8_t offset = (int8_t)fetch();
                if (m_af.b.l & ZF) {
                    m_pc.w += offset;
                    m_wz.w = m_pc.w;
                    eat(12);
                } else {
                    eat(7);
                }
                return;
            }

            case 0x29: // ADD HL,HL
                alu_add16(m_hl, m_hl.w);
                eat(11);
                return;

            case 0x2A: { // LD HL,(nn)
                uint16_t addr = fetch16();
                m_hl.b.l = mem_read(addr);
                m_hl.b.h = mem_read(addr + 1);
                m_wz.w = addr + 1;
                eat(16);
                return;
            }

            case 0x2B: // DEC HL
                m_hl.w--;
                eat(6);
                return;

            case 0x2C: // INC L
                m_hl.b.l = alu_inc(m_hl.b.l);
                eat(4);
                return;

            case 0x2D: // DEC L
                m_hl.b.l = alu_dec(m_hl.b.l);
                eat(4);
                return;

            case 0x2E: // LD L,n
                m_hl.b.l = fetch();
                eat(7);
                return;

            case 0x2F: // CPL
                m_af.b.h ^= 0xFF;
                m_af.b.l = (m_af.b.l & (SF | ZF | PF | CF)) |
                           (m_af.b.h & (YF | XF)) |
                           HF | NF;
                m_q = m_af.b.l;
                eat(4);
                return;

            case 0x30: { // JR NC,e
                int8_t offset = (int8_t)fetch();
                if (!(m_af.b.l & CF)) {
                    m_pc.w += offset;
                    m_wz.w = m_pc.w;
                    eat(12);
                } else {
                    eat(7);
                }
                return;
            }

            case 0x31: // LD SP,nn
                m_sp.w = fetch16();
                eat(10);
                return;

            case 0x32: { // LD (nn),A
                uint16_t addr = fetch16();
                mem_write(addr, m_af.b.h);
                m_wz.b.l = (addr + 1) & 0xFF;
                m_wz.b.h = m_af.b.h;
                eat(13);
                return;
            }

            case 0x33: // INC SP
                m_sp.w++;
                eat(6);
                return;

            case 0x34: { // INC (HL)
                uint8_t val = mem_read(m_hl.w);
                val = alu_inc(val);
                mem_write(m_hl.w, val);
                eat(11);
                return;
            }

            case 0x35: { // DEC (HL)
                uint8_t val = mem_read(m_hl.w);
                val = alu_dec(val);
                mem_write(m_hl.w, val);
                eat(11);
                return;
            }

            case 0x36: // LD (HL),n
                mem_write(m_hl.w, fetch());
                eat(10);
                return;

            case 0x37: { // SCF
                uint8_t yx = ((m_prev_q ^ m_af.b.l) | m_af.b.h) & (YF | XF);
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) | yx | CF;
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            case 0x38: { // JR C,e
                int8_t offset = (int8_t)fetch();
                if (m_af.b.l & CF) {
                    m_pc.w += offset;
                    m_wz.w = m_pc.w;
                    eat(12);
                } else {
                    eat(7);
                }
                return;
            }

            case 0x39: // ADD HL,SP
                alu_add16(m_hl, m_sp.w);
                eat(11);
                return;

            case 0x3A: { // LD A,(nn)
                uint16_t addr = fetch16();
                m_af.b.h = mem_read(addr);
                m_wz.w = addr + 1;
                eat(13);
                return;
            }

            case 0x3B: // DEC SP
                m_sp.w--;
                eat(6);
                return;

            case 0x3C: // INC A
                m_af.b.h = alu_inc(m_af.b.h);
                eat(4);
                return;

            case 0x3D: // DEC A
                m_af.b.h = alu_dec(m_af.b.h);
                eat(4);
                return;

            case 0x3E: // LD A,n
                m_af.b.h = fetch();
                eat(7);
                return;

            case 0x3F: { // CCF
                uint8_t yx = ((m_prev_q ^ m_af.b.l) | m_af.b.h) & (YF | XF);
                m_af.b.l = (m_af.b.l & (SF | ZF | PF)) |
                           ((m_af.b.l & CF) ? HF : 0) |
                           yx |
                           ((m_af.b.l & CF) ^ CF);
                m_q = m_af.b.l;
                eat(4);
                return;
            }

            default:
                std::fprintf(stderr, "Z80: unimplemented opcode 0x%02X at PC=0x%04X\n",
                             opcode, m_pc.w - 1);
                eat(4);
                return;
        }
    }
@

\subsection{Control Block (0xC0--0xFF)}

This block contains conditional returns, push/pop, jumps, calls, RST,
I/O instructions, the EI/DI pair, exchange instructions, and the prefix
escape bytes (CB, DD, ED, FD).

<<unprefixed 0xC0-0xFF control block>>=
    // 0xC0-0xFF
    switch (opcode) {
        case 0xC0: // RET NZ
            if (!(m_af.b.l & ZF)) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xC1: // POP BC
            m_bc.b.l = mem_read(m_sp.w++);
            m_bc.b.h = mem_read(m_sp.w++);
            eat(10);
            return;

        case 0xC2: { // JP NZ,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & ZF)) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xC3: { // JP nn
            uint16_t addr = fetch16();
            m_pc.w = addr;
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xC4: { // CALL NZ,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & ZF)) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xC5: // PUSH BC
            mem_write(--m_sp.w, m_bc.b.h);
            mem_write(--m_sp.w, m_bc.b.l);
            eat(11);
            return;

        case 0xC6: // ADD A,n
            alu_add(fetch());
            eat(7);
            return;

        case 0xC7: // RST 00
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0000;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xC8: // RET Z
            if (m_af.b.l & ZF) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xC9: // RET
            m_pc.b.l = mem_read(m_sp.w++);
            m_pc.b.h = mem_read(m_sp.w++);
            m_wz.w = m_pc.w;
            eat(10);
            return;

        case 0xCA: { // JP Z,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & ZF) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xCB: // CB prefix
            execute_cb();
            return;

        case 0xCC: { // CALL Z,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & ZF) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xCD: { // CALL nn
            uint16_t addr = fetch16();
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = addr;
            m_wz.w = addr;
            eat(17);
            return;
        }

        case 0xCE: // ADC A,n
            alu_adc(fetch());
            eat(7);
            return;

        case 0xCF: // RST 08
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0008;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xD0: // RET NC
            if (!(m_af.b.l & CF)) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xD1: // POP DE
            m_de.b.l = mem_read(m_sp.w++);
            m_de.b.h = mem_read(m_sp.w++);
            eat(10);
            return;

        case 0xD2: { // JP NC,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & CF)) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xD3: { // OUT (n),A
            uint8_t port = fetch();
            uint16_t addr = (m_af.b.h << 8) | port;
            io_write(addr, m_af.b.h);
            m_wz.b.l = port + 1;
            m_wz.b.h = m_af.b.h;
            eat(11);
            return;
        }

        case 0xD4: { // CALL NC,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & CF)) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xD5: // PUSH DE
            mem_write(--m_sp.w, m_de.b.h);
            mem_write(--m_sp.w, m_de.b.l);
            eat(11);
            return;

        case 0xD6: // SUB n
            alu_sub(fetch());
            eat(7);
            return;

        case 0xD7: // RST 10
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0010;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xD8: // RET C
            if (m_af.b.l & CF) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xD9: { // EXX
            uint16_t tmp;
            tmp = m_bc.w; m_bc.w = m_bc2.w; m_bc2.w = tmp;
            tmp = m_de.w; m_de.w = m_de2.w; m_de2.w = tmp;
            tmp = m_hl.w; m_hl.w = m_hl2.w; m_hl2.w = tmp;
            eat(4);
            return;
        }

        case 0xDA: { // JP C,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & CF) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xDB: { // IN A,(n)
            uint8_t port = fetch();
            uint16_t full_addr = (m_af.b.h @<< 8) | port;
            m_wz.w = full_addr + 1;
            m_af.b.h = io_read(full_addr);
            eat(11);
            return;
        }

        case 0xDC: { // CALL C,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & CF) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xDD: // DD prefix (IX instructions)
            execute_dd();
            return;

        case 0xDE: // SBC A,n
            alu_sbc(fetch());
            eat(7);
            return;

        case 0xDF: // RST 18
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0018;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xE0: // RET PO
            if (!(m_af.b.l & PF)) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xE1: // POP HL
            m_hl.b.l = mem_read(m_sp.w++);
            m_hl.b.h = mem_read(m_sp.w++);
            eat(10);
            return;

        case 0xE2: { // JP PO,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & PF)) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xE3: { // EX (SP),HL
            uint8_t lo = mem_read(m_sp.w);
            uint8_t hi = mem_read(m_sp.w + 1);
            mem_write(m_sp.w, m_hl.b.l);
            mem_write(m_sp.w + 1, m_hl.b.h);
            m_hl.b.l = lo;
            m_hl.b.h = hi;
            m_wz.w = m_hl.w;
            eat(19);
            return;
        }

        case 0xE4: { // CALL PO,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & PF)) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xE5: // PUSH HL
            mem_write(--m_sp.w, m_hl.b.h);
            mem_write(--m_sp.w, m_hl.b.l);
            eat(11);
            return;

        case 0xE6: // AND n
            alu_and(fetch());
            eat(7);
            return;

        case 0xE7: // RST 20
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0020;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xE8: // RET PE
            if (m_af.b.l & PF) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xE9: // JP (HL)
            m_pc.w = m_hl.w;
            eat(4);
            return;

        case 0xEA: { // JP PE,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & PF) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xEB: { // EX DE,HL
            uint16_t tmp = m_de.w;
            m_de.w = m_hl.w;
            m_hl.w = tmp;
            eat(4);
            return;
        }

        case 0xEC: { // CALL PE,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & PF) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xED: // ED prefix
            execute_ed();
            return;

        case 0xEE: // XOR n
            alu_xor(fetch());
            eat(7);
            return;

        case 0xEF: // RST 28
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0028;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xF0: // RET P
            if (!(m_af.b.l & SF)) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xF1: // POP AF
            m_af.b.l = mem_read(m_sp.w++);
            m_af.b.h = mem_read(m_sp.w++);
            eat(10);
            return;

        case 0xF2: { // JP P,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & SF)) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xF3: // DI
            m_iff1 = 0;
            m_iff2 = 0;
            eat(4);
            return;

        case 0xF4: { // CALL P,nn
            uint16_t addr = fetch16();
            if (!(m_af.b.l & SF)) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xF5: // PUSH AF
            mem_write(--m_sp.w, m_af.b.h);
            mem_write(--m_sp.w, m_af.b.l);
            eat(11);
            return;

        case 0xF6: // OR n
            alu_or(fetch());
            eat(7);
            return;

        case 0xF7: // RST 30
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0030;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        case 0xF8: // RET M
            if (m_af.b.l & SF) {
                m_pc.b.l = mem_read(m_sp.w++);
                m_pc.b.h = mem_read(m_sp.w++);
                m_wz.w = m_pc.w;
                eat(11);
            } else {
                eat(5);
            }
            return;

        case 0xF9: // LD SP,HL
            m_sp.w = m_hl.w;
            eat(6);
            return;

        case 0xFA: { // JP M,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & SF) {
                m_pc.w = addr;
            }
            m_wz.w = addr;
            eat(10);
            return;
        }

        case 0xFB: // EI
            m_iff1 = 1;
            m_iff2 = 1;
            m_ei_pending = true;
            eat(4);
            return;

        case 0xFC: { // CALL M,nn
            uint16_t addr = fetch16();
            if (m_af.b.l & SF) {
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = addr;
                eat(17);
            } else {
                eat(10);
            }
            m_wz.w = addr;
            return;
        }

        case 0xFD: // FD prefix (IY instructions)
            execute_fd();
            return;

        case 0xFE: // CP n
            alu_cp(fetch());
            eat(7);
            return;

        case 0xFF: // RST 38
            mem_write(--m_sp.w, m_pc.b.h);
            mem_write(--m_sp.w, m_pc.b.l);
            m_pc.w = 0x0038;
            m_wz.w = m_pc.w;
            eat(11);
            return;

        default:
            std::fprintf(stderr, "Z80: unimplemented opcode 0x%02X at PC=0x%04X\n",
                         opcode, m_pc.w - 1);
            eat(4);
            return;
    }
