\subsection{ALU Operations}

Each ALU helper updates the A register and/or flags. The half-carry and
overflow flags use lookup tables indexed by the sign bits of the operands
and result. This matches the approach used by MAME, FUSE, and other
well-tested Z80 emulators.

The lookup index packs three sign bits:
\begin{verbatim}
  bit 2: sign of operand A (before operation)
  bit 1: sign of operand B
  bit 0: sign of result
\end{verbatim}

For half-carry, bits 3 are used instead of bit 7.

<<z80 alu operations>>=
void Z80::alu_add(uint8_t val)
{
    uint16_t result = m_af.b.h + val;
    uint8_t lookup = ((m_af.b.h & 0x88) >> 3) |
                     ((val & 0x88) >> 2) |
                     ((result & 0x88) >> 1);
    m_af.b.h = result & 0xFF;
    m_af.b.l = ((result & 0x100) ? CF : 0) |
               halfcarry_add[lookup & 0x07] |
               overflow_add[lookup >> 4] |
               sz53_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_adc(uint8_t val)
{
    uint16_t result = m_af.b.h + val + (m_af.b.l & CF);
    uint8_t lookup = ((m_af.b.h & 0x88) >> 3) |
                     ((val & 0x88) >> 2) |
                     ((result & 0x88) >> 1);
    m_af.b.h = result & 0xFF;
    m_af.b.l = ((result & 0x100) ? CF : 0) |
               halfcarry_add[lookup & 0x07] |
               overflow_add[lookup >> 4] |
               sz53_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_sub(uint8_t val)
{
    uint16_t result = m_af.b.h - val;
    uint8_t lookup = ((m_af.b.h & 0x88) >> 3) |
                     ((val & 0x88) >> 2) |
                     ((result & 0x88) >> 1);
    m_af.b.h = result & 0xFF;
    m_af.b.l = ((result & 0x100) ? CF : 0) | NF |
               halfcarry_sub[lookup & 0x07] |
               overflow_sub[lookup >> 4] |
               sz53_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_sbc(uint8_t val)
{
    uint16_t result = m_af.b.h - val - (m_af.b.l & CF);
    uint8_t lookup = ((m_af.b.h & 0x88) >> 3) |
                     ((val & 0x88) >> 2) |
                     ((result & 0x88) >> 1);
    m_af.b.h = result & 0xFF;
    m_af.b.l = ((result & 0x100) ? CF : 0) | NF |
               halfcarry_sub[lookup & 0x07] |
               overflow_sub[lookup >> 4] |
               sz53_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_and(uint8_t val)
{
    m_af.b.h &= val;
    m_af.b.l = HF | szp_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_xor(uint8_t val)
{
    m_af.b.h ^= val;
    m_af.b.l = szp_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_or(uint8_t val)
{
    m_af.b.h |= val;
    m_af.b.l = szp_table[m_af.b.h];
    m_q = m_af.b.l;
}

void Z80::alu_cp(uint8_t val)
{
    uint16_t result = m_af.b.h - val;
    uint8_t lookup = ((m_af.b.h & 0x88) >> 3) |
                     ((val & 0x88) >> 2) |
                     ((result & 0x88) >> 1);
    // CP: Y and X flags come from the operand, not the result
    m_af.b.l = ((result & 0x100) ? CF : 0) | NF |
               halfcarry_sub[lookup & 0x07] |
               overflow_sub[lookup >> 4] |
               (val & (YF | XF)) |
               (result & SF) |
               ((result & 0xFF) == 0 ? ZF : 0);
    m_q = m_af.b.l;
}

uint8_t Z80::alu_inc(uint8_t val)
{
    uint8_t result = val + 1;
    m_af.b.l = (m_af.b.l & CF) |
               ((val & 0x0F) == 0x0F ? HF : 0) |
               (val == 0x7F ? VF : 0) |
               sz53_table[result];
    m_q = m_af.b.l;
    return result;
}

uint8_t Z80::alu_dec(uint8_t val)
{
    uint8_t result = val - 1;
    m_af.b.l = (m_af.b.l & CF) | NF |
               ((val & 0x0F) == 0x00 ? HF : 0) |
               (val == 0x80 ? VF : 0) |
               sz53_table[result];
    m_q = m_af.b.l;
    return result;
}

void Z80::alu_add16(PAIR16& dst, uint16_t val)
{
    uint32_t result = dst.w + val;
    m_wz.w = dst.w + 1;
    m_af.b.l = (m_af.b.l & (SF | ZF | VF)) |
               (((dst.w ^ result ^ val) >> 8) & HF) |
               ((result >> 16) & CF) |
               ((result >> 8) & (YF | XF));
    dst.w = result & 0xFFFF;
    m_q = m_af.b.l;
}

void Z80::alu_adc16(uint16_t val)
{
    uint32_t result = m_hl.w + val + (m_af.b.l & CF);
    m_wz.w = m_hl.w + 1;
    uint8_t lookup = ((m_hl.w & 0x8800) >> 11) |
                     ((val & 0x8800) >> 10) |
                     ((result & 0x8800) >> 9);
    m_hl.w = result & 0xFFFF;
    m_af.b.l = ((result >> 16) & CF) |
               overflow_add[lookup >> 4] |
               (m_hl.b.h & (SF | YF | XF)) |
               halfcarry_add[lookup & 0x07] |
               (m_hl.w == 0 ? ZF : 0);
    m_q = m_af.b.l;
}

void Z80::alu_sbc16(uint16_t val)
{
    uint32_t result = m_hl.w - val - (m_af.b.l & CF);
    m_wz.w = m_hl.w + 1;
    uint8_t lookup = ((m_hl.w & 0x8800) >> 11) |
                     ((val & 0x8800) >> 10) |
                     ((result & 0x8800) >> 9);
    m_hl.w = result & 0xFFFF;
    m_af.b.l = ((result >> 16) & CF) | NF |
               overflow_sub[lookup >> 4] |
               (m_hl.b.h & (SF | YF | XF)) |
               halfcarry_sub[lookup & 0x07] |
               (m_hl.w == 0 ? ZF : 0);
    m_q = m_af.b.l;
}
