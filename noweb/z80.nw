\subsection{Memory Access}

All memory reads and writes go through the [[AddressSpace]] callbacks.
The [[fetch]] function reads a byte at PC and increments PC. The [[fetch16]]
function reads a 16-bit little-endian value (low byte first).

<<z80 memory access>>=
uint8_t Z80::mem_read(uint16_t addr)
{
    return m_program.read(addr);
}

void Z80::mem_write(uint16_t addr, uint8_t data)
{
    m_program.write(addr, data);
}

uint8_t Z80::io_read(uint16_t addr)
{
    return m_io.read(addr & 0xFF);
}

void Z80::io_write(uint16_t addr, uint8_t data)
{
    m_io.write(addr & 0xFF, data);
}

uint8_t Z80::fetch()
{
    uint8_t val = mem_read(m_pc.w);
    m_pc.w++;
    return val;
}

uint16_t Z80::fetch16()
{
    uint8_t lo = fetch();
    uint8_t hi = fetch();
    return (hi << 8) | lo;
}
@

\subsection{Register Decode}

Many Z80 opcodes encode register indices in bits 5--3 or 2--0 of the opcode.
The mapping is: B=0, C=1, D=2, E=3, H=4, L=5, (HL)=6, A=7.

For 16-bit register pairs, two encodings exist:
\begin{itemize}
\item SP variant (arithmetic): BC=0, DE=1, HL=2, SP=3
\item AF variant (push/pop): BC=0, DE=1, HL=2, AF=3
\end{itemize}

<<z80 register decode>>=
uint8_t Z80::read_r8(int idx)
{
    switch (idx & 7) {
        case 0: return m_bc.b.h;
        case 1: return m_bc.b.l;
        case 2: return m_de.b.h;
        case 3: return m_de.b.l;
        case 4: return m_hl.b.h;
        case 5: return m_hl.b.l;
        case 6: return mem_read(m_hl.w);
        case 7: return m_af.b.h;
    }
    return 0xFF; // unreachable
}

void Z80::write_r8(int idx, uint8_t val)
{
    switch (idx & 7) {
        case 0: m_bc.b.h = val; break;
        case 1: m_bc.b.l = val; break;
        case 2: m_de.b.h = val; break;
        case 3: m_de.b.l = val; break;
        case 4: m_hl.b.h = val; break;
        case 5: m_hl.b.l = val; break;
        case 6: mem_write(m_hl.w, val); break;
        case 7: m_af.b.h = val; break;
    }
}

uint16_t& Z80::reg16_sp(int idx)
{
    static uint16_t dummy = 0;
    switch (idx & 3) {
        case 0: return m_bc.w;
        case 1: return m_de.w;
        case 2: return m_hl.w;
        case 3: return m_sp.w;
    }
    return dummy; // unreachable
}

uint16_t& Z80::reg16_af(int idx)
{
    static uint16_t dummy = 0;
    switch (idx & 3) {
        case 0: return m_bc.w;
        case 1: return m_de.w;
        case 2: return m_hl.w;
        case 3: return m_af.w;
    }
    return dummy; // unreachable
}

bool Z80::test_cc(int cc)
{
    uint8_t f = m_af.b.l;
    switch (cc & 7) {
        case 0: return !(f & ZF);  // NZ
        case 1: return  (f & ZF);  // Z
        case 2: return !(f & CF);  // NC
        case 3: return  (f & CF);  // C
        case 4: return !(f & PF);  // PO
        case 5: return  (f & PF);  // PE
        case 6: return !(f & SF);  // P
        case 7: return  (f & SF);  // M
    }
    return false;
}
@

