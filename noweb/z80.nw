\subsection{Flag Lookup Tables}

Pre-computed tables for Sign, Zero, Parity, and the undocumented Y/X flags.
The [[sz53]] table provides S, Z, Y, and X flags for any 8-bit result.
The [[szp]] table adds the parity flag.

Parity is even parity: set when the number of 1-bits is even.

Half-carry and overflow tables encode the truth tables for these flags
based on the signs (bit 7 or bit 3) of the operands and result.

<<flag lookup tables>>=
static uint8_t sz53_table[256];
static uint8_t parity_table[256];
static uint8_t szp_table[256];

static const uint8_t halfcarry_add[] = { 0, HF, HF, HF, 0, 0, 0, HF };
static const uint8_t halfcarry_sub[] = { 0, 0, HF, 0, HF, 0, HF, HF };
static const uint8_t overflow_add[]  = { 0, 0, 0, VF, VF, 0, 0, 0 };
static const uint8_t overflow_sub[]  = { 0, VF, 0, 0, 0, 0, VF, 0 };

static bool tables_initialized = false;

static void init_tables()
{
    if (tables_initialized) return;

    for (int i = 0; i < 256; i++) {
        uint8_t sf = i & SF;
        uint8_t zf = (i == 0) ? ZF : 0;
        uint8_t yxf = i & (YF | XF);
        sz53_table[i] = sf | zf | yxf;

        // Even parity: count 1-bits
        int bits = 0;
        uint8_t v = i;
        while (v) { bits += v & 1; v >>= 1; }
        parity_table[i] = (bits & 1) ? 0 : PF;

        szp_table[i] = sz53_table[i] | parity_table[i];
    }

    tables_initialized = true;
}
@

