\section{Interrupt Handling}

The Z80 supports two interrupt types:
\begin{itemize}
\item \textbf{NMI}: non-maskable, always jumps to 0x0066. Clears IFF1 only.
\item \textbf{IRQ}: maskable, behavior depends on interrupt mode (IM 0/1/2).
\end{itemize}

NMI has priority over IRQ. Both un-halt the CPU.

<<z80 interrupt handling>>=
void Z80::irq(uint8_t vector)
{
    m_irq_pending = true;
    m_irq_vector = vector;
}

void Z80::nmi()
{
    m_nmi_pending = true;
}

void Z80::handle_interrupts()
{
    if (m_nmi_pending) {
        m_nmi_pending = false;
        m_halted = false;
        m_iff2 = m_iff1;  // preserve IFF1 in IFF2
        m_iff1 = 0;
        mem_write(--m_sp.w, m_pc.b.h);
        mem_write(--m_sp.w, m_pc.b.l);
        m_pc.w = 0x0066;
        m_wz.w = 0x0066;
        m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
        eat(11);
        return;
    }

    if (m_irq_pending && m_iff1) {
        m_irq_pending = false;
        m_halted = false;
        m_iff1 = 0;
        m_iff2 = 0;
        m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);

        switch (m_im) {
            case 0: {
                // IM 0: Execute instruction from data bus
                // Common case: RST vector on bus
                uint8_t vec = m_irq_vector;
                if ((vec & 0xC7) == 0xC7) {
                    // RST instruction: push PC, jump to vector address
                    mem_write(--m_sp.w, m_pc.b.h);
                    mem_write(--m_sp.w, m_pc.b.l);
                    m_pc.w = vec & 0x38;
                    m_wz.w = m_pc.w;
                    eat(13);
                } else {
                    // Non-RST vector: treat as call to the vector address
                    // Berzerk uses 0xFC which doesn't match RST pattern
                    // 0xFC = CALL nn -- but the nn isn't on the bus
                    // Actually, for single-byte vectors that aren't RST,
                    // execute them as instructions
                    mem_write(--m_sp.w, m_pc.b.h);
                    mem_write(--m_sp.w, m_pc.b.l);
                    m_pc.w = vec & 0x38;
                    m_wz.w = m_pc.w;
                    eat(13);
                }
                break;
            }

            case 1:
                // IM 1: RST 38h
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = 0x0038;
                m_wz.w = 0x0038;
                eat(13);
                break;

            case 2: {
                // IM 2: Vector table lookup
                uint16_t vec_addr = (m_i << 8) | (m_irq_vector & 0xFE);
                uint16_t target = mem_read(vec_addr) |
                                  (mem_read(vec_addr + 1) << 8);
                mem_write(--m_sp.w, m_pc.b.h);
                mem_write(--m_sp.w, m_pc.b.l);
                m_pc.w = target;
                m_wz.w = target;
                eat(19);
                break;
            }
        }
    }
}
