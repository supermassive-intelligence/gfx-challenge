\section{DD/FD Prefix: Index Register Operations}

The DD and FD prefixes replace HL with IX and IY respectively in most
instructions. Where unprefixed uses [[(HL)]], the indexed version reads
a displacement byte and accesses [[(IX+d)]] or [[(IY+d)]].

The undocumented registers IXH, IXL, IYH, IYL are accessible through
the same encoding (H=4, L=5 in the register field), but only for
instructions that do not involve [[(HL)]].

A shared [[execute\_index]] function handles both DD and FD prefixes.

<<z80 dd fd prefix>>=
void Z80::execute_dd()
{
    execute_index(m_ix);
}

void Z80::execute_fd()
{
    execute_index(m_iy);
}

void Z80::execute_index(PAIR16& idx)
{
    m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
    uint8_t op = fetch();

    // Helper lambdas for index register access
    // When reg field is 4(H) or 5(L), access IXH/IXL instead of H/L
    auto read_idx_r8 = [&](int r) -> uint8_t {
        switch (r & 7) {
            case 0: return m_bc.b.h;
            case 1: return m_bc.b.l;
            case 2: return m_de.b.h;
            case 3: return m_de.b.l;
            case 4: return idx.b.h;  // IXH/IYH instead of H
            case 5: return idx.b.l;  // IXL/IYL instead of L
            case 6: {  // (IX+d)/(IY+d) -- displacement already fetched
                // This should not be called for (IX+d) from here
                return 0xFF;
            }
            case 7: return m_af.b.h;
        }
        return 0xFF;
    };

    switch (op) {
        case 0x09: // ADD IX,BC
            alu_add16(idx, m_bc.w);
            eat(15);
            return;

        case 0x19: // ADD IX,DE
            alu_add16(idx, m_de.w);
            eat(15);
            return;

        case 0x21: // LD IX,nn
            idx.w = fetch16();
            eat(14);
            return;

        case 0x22: { // LD (nn),IX
            uint16_t addr = fetch16();
            mem_write(addr, idx.b.l);
            mem_write(addr + 1, idx.b.h);
            m_wz.w = addr + 1;
            eat(20);
            return;
        }

        case 0x23: // INC IX
            idx.w++;
            eat(10);
            return;

        case 0x24: // INC IXH
            idx.b.h = alu_inc(idx.b.h);
            eat(8);
            return;

        case 0x25: // DEC IXH
            idx.b.h = alu_dec(idx.b.h);
            eat(8);
            return;

        case 0x26: // LD IXH,n
            idx.b.h = fetch();
            eat(11);
            return;

        case 0x29: // ADD IX,IX
            alu_add16(idx, idx.w);
            eat(15);
            return;

        case 0x2A: { // LD IX,(nn)
            uint16_t addr = fetch16();
            idx.b.l = mem_read(addr);
            idx.b.h = mem_read(addr + 1);
            m_wz.w = addr + 1;
            eat(20);
            return;
        }

        case 0x2B: // DEC IX
            idx.w--;
            eat(10);
            return;

        case 0x2C: // INC IXL
            idx.b.l = alu_inc(idx.b.l);
            eat(8);
            return;

        case 0x2D: // DEC IXL
            idx.b.l = alu_dec(idx.b.l);
            eat(8);
            return;

        case 0x2E: // LD IXL,n
            idx.b.l = fetch();
            eat(11);
            return;

        case 0x34: { // INC (IX+d)
            int8_t d = (int8_t)fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            uint8_t val = mem_read(addr);
            val = alu_inc(val);
            mem_write(addr, val);
            eat(23);
            return;
        }

        case 0x35: { // DEC (IX+d)
            int8_t d = (int8_t)fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            uint8_t val = mem_read(addr);
            val = alu_dec(val);
            mem_write(addr, val);
            eat(23);
            return;
        }

        case 0x36: { // LD (IX+d),n
            int8_t d = (int8_t)fetch();
            uint8_t n = fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            mem_write(addr, n);
            eat(19);
            return;
        }

        case 0x39: // ADD IX,SP
            alu_add16(idx, m_sp.w);
            eat(15);
            return;

        // LD r,(IX+d) -- 0x46, 0x4E, 0x56, 0x5E, 0x66, 0x6E, 0x7E
        case 0x46: case 0x4E: case 0x56: case 0x5E:
        case 0x66: case 0x6E: case 0x7E: {
            int8_t d = (int8_t)fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            int dst = (op >> 3) & 7;
            // For dst 4,5 we write to the REAL H,L (not IXH/IXL)
            write_r8(dst, mem_read(addr));
            eat(19);
            return;
        }

        // LD (IX+d),r -- 0x70-0x77 (except 0x76 which is HALT, handled as default)
        case 0x70: case 0x71: case 0x72: case 0x73:
        case 0x74: case 0x75: case 0x77: {
            int8_t d = (int8_t)fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            int src = op & 7;
            // For src 4,5 we read the REAL H,L
            mem_write(addr, read_r8(src));
            eat(19);
            return;
        }

        // LD between IXH/IXL and registers (undocumented)
        // 0x44=LD B,IXH  0x45=LD B,IXL  0x4C=LD C,IXH  0x4D=LD C,IXL
        // 0x54=LD D,IXH  0x55=LD D,IXL  0x5C=LD E,IXH  0x5D=LD E,IXL
        // 0x60=LD IXH,B  ... 0x67=LD IXH,A
        // 0x68=LD IXL,B  ... 0x6F=LD IXL,A
        // 0x7C=LD A,IXH  0x7D=LD A,IXL
        case 0x44: case 0x45: case 0x4C: case 0x4D:
        case 0x54: case 0x55: case 0x5C: case 0x5D:
        case 0x7C: case 0x7D: {
            // LD r, IXH/IXL (dst is normal reg, src is IXH or IXL)
            int dst = (op >> 3) & 7;
            int src = op & 7;
            write_r8(dst, read_idx_r8(src));
            eat(8);
            return;
        }

        case 0x60: case 0x61: case 0x62: case 0x63:
        case 0x64: case 0x65: case 0x67: {
            // LD IXH, r
            int src = op & 7;
            idx.b.h = read_idx_r8(src);
            eat(8);
            return;
        }

        case 0x68: case 0x69: case 0x6A: case 0x6B:
        case 0x6C: case 0x6D: case 0x6F: {
            // LD IXL, r
            int src = op & 7;
            idx.b.l = read_idx_r8(src);
            eat(8);
            return;
        }

        // ALU A,(IX+d) -- 0x86, 0x8E, 0x96, 0x9E, 0xA6, 0xAE, 0xB6, 0xBE
        case 0x86: case 0x8E: case 0x96: case 0x9E:
        case 0xA6: case 0xAE: case 0xB6: case 0xBE: {
            int8_t d = (int8_t)fetch();
            uint16_t addr = idx.w + d;
            m_wz.w = addr;
            uint8_t val = mem_read(addr);
            int alu_op = (op >> 3) & 7;
            switch (alu_op) {
                case 0: alu_add(val); break;
                case 1: alu_adc(val); break;
                case 2: alu_sub(val); break;
                case 3: alu_sbc(val); break;
                case 4: alu_and(val); break;
                case 5: alu_xor(val); break;
                case 6: alu_or(val);  break;
                case 7: alu_cp(val);  break;
            }
            eat(19);
            return;
        }

        // ALU A, IXH/IXL (undocumented)
        case 0x84: case 0x85: case 0x8C: case 0x8D:
        case 0x94: case 0x95: case 0x9C: case 0x9D:
        case 0xA4: case 0xA5: case 0xAC: case 0xAD:
        case 0xB4: case 0xB5: case 0xBC: case 0xBD: {
            int src = op & 7;
            uint8_t val = read_idx_r8(src);
            int alu_op = (op >> 3) & 7;
            switch (alu_op) {
                case 0: alu_add(val); break;
                case 1: alu_adc(val); break;
                case 2: alu_sub(val); break;
                case 3: alu_sbc(val); break;
                case 4: alu_and(val); break;
                case 5: alu_xor(val); break;
                case 6: alu_or(val);  break;
                case 7: alu_cp(val);  break;
            }
            eat(8);
            return;
        }

        case 0xCB: // DDCB / FDCB prefix
            execute_index_cb(idx);
            return;

        case 0xE1: // POP IX
            idx.b.l = mem_read(m_sp.w++);
            idx.b.h = mem_read(m_sp.w++);
            eat(14);
            return;

        case 0xE3: { // EX (SP),IX
            uint8_t lo = mem_read(m_sp.w);
            uint8_t hi = mem_read(m_sp.w + 1);
            mem_write(m_sp.w, idx.b.l);
            mem_write(m_sp.w + 1, idx.b.h);
            idx.b.l = lo;
            idx.b.h = hi;
            m_wz.w = idx.w;
            eat(23);
            return;
        }

        case 0xE5: // PUSH IX
            mem_write(--m_sp.w, idx.b.h);
            mem_write(--m_sp.w, idx.b.l);
            eat(15);
            return;

        case 0xE9: // JP (IX)
            m_pc.w = idx.w;
            eat(8);
            return;

        case 0xF9: // LD SP,IX
            m_sp.w = idx.w;
            eat(10);
            return;

        default:
            // Unrecognized DD/FD opcodes execute as unprefixed
            // (the prefix is silently consumed)
            execute_opcode(op);
            return;
    }
}

void Z80::execute_ddcb()
{
    execute_index_cb(m_ix);
}

void Z80::execute_fdcb()
{
    execute_index_cb(m_iy);
}

void Z80::execute_index_cb(PAIR16& idx)
{
    // Format: DD CB dd oo (displacement before opcode)
    int8_t d = (int8_t)fetch();
    uint8_t op = fetch();
    uint16_t addr = idx.w + d;
    m_wz.w = addr;
    int reg = op & 7;  // undocumented: result also stored to this register
    int bit = (op >> 3) & 7;
    uint8_t val = mem_read(addr);

    switch (op & 0xC0) {
        case 0x00: { // Rotates and shifts on (IX+d)
            uint8_t result;
            switch (bit) {
                case 0: result = (val @<< 1) | (val >> 7);
                        m_af.b.l = (val >> 7) | szp_table[result]; break;
                case 1: result = (val >> 1) | (val @<< 7);
                        m_af.b.l = (val & CF) | szp_table[result]; break;
                case 2: result = (val @<< 1) | (m_af.b.l & CF);
                        m_af.b.l = (val >> 7) | szp_table[result]; break;
                case 3: result = (val >> 1) | ((m_af.b.l & CF) @<< 7);
                        m_af.b.l = (val & CF) | szp_table[result]; break;
                case 4: result = val << 1;
                        m_af.b.l = (val >> 7) | szp_table[result]; break;
                case 5: result = (val >> 1) | (val & 0x80);
                        m_af.b.l = (val & CF) | szp_table[result]; break;
                case 6: result = (val << 1) | 0x01;
                        m_af.b.l = (val >> 7) | szp_table[result]; break;
                case 7: result = val >> 1;
                        m_af.b.l = (val & CF) | szp_table[result]; break;
                default: result = val; break;
            }
            mem_write(addr, result);
            // Undocumented: also store to register (unless reg == 6)
            if (reg != 6) write_r8(reg, result);
            m_q = m_af.b.l;
            eat(23);
            break;
        }

        case 0x40: { // BIT b,(IX+d)
            uint8_t result = val & (1 << bit);
            m_af.b.l = (m_af.b.l & CF) | HF |
                       (result ? (result & SF) : (ZF | PF)) |
                       (m_wz.b.h & (YF | XF));
            m_q = m_af.b.l;
            eat(20);
            break;
        }

        case 0x80: { // RES b,(IX+d)
            uint8_t result = val & ~(1 << bit);
            mem_write(addr, result);
            if (reg != 6) write_r8(reg, result);
            eat(23);
            break;
        }

        case 0xC0: { // SET b,(IX+d)
            uint8_t result = val | (1 << bit);
            mem_write(addr, result);
            if (reg != 6) write_r8(reg, result);
            eat(23);
            break;
        }
    }
}
