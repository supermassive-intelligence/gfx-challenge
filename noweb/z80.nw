\section{CB Prefix: Bit Operations}

The CB prefix introduces rotate, shift, bit test, reset, and set operations.
The opcode byte following CB encodes:
\begin{itemize}
\item Bits 7--6: operation group (rotate/shift=0, BIT=1, RES=2, SET=3)
\item Bits 5--3: bit number (for BIT/RES/SET) or shift type (for group 0)
\item Bits 2--0: register index (same as unprefixed)
\end{itemize}

Shift types in group 0: RLC(0), RRC(1), RL(2), RR(3), SLA(4), SRA(5),
SLL(6, undocumented), SRL(7).

<<z80 cb prefix>>=
void Z80::execute_cb()
{
    m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
    uint8_t op = fetch();
    int reg = op & 7;
    int bit = (op >> 3) & 7;
    uint8_t val = read_r8(reg);
    bool is_hl = (reg == 6);

    switch (op & 0xC0) {
        case 0x00: { // Rotates and shifts
            uint8_t result;
            switch (bit) {
                case 0: // RLC
                    result = (val @<< 1) | (val >> 7);
                    m_af.b.l = (val >> 7) | szp_table[result];
                    break;
                case 1: // RRC
                    result = (val >> 1) | (val @<< 7);
                    m_af.b.l = (val & CF) | szp_table[result];
                    break;
                case 2: // RL
                    result = (val << 1) | (m_af.b.l & CF);
                    m_af.b.l = (val >> 7) | szp_table[result];
                    break;
                case 3: // RR
                    result = (val >> 1) | ((m_af.b.l & CF) @<< 7);
                    m_af.b.l = (val & CF) | szp_table[result];
                    break;
                case 4: // SLA
                    result = val << 1;
                    m_af.b.l = (val >> 7) | szp_table[result];
                    break;
                case 5: // SRA
                    result = (val >> 1) | (val & 0x80);
                    m_af.b.l = (val & CF) | szp_table[result];
                    break;
                case 6: // SLL (undocumented: shift left, bit 0 = 1)
                    result = (val << 1) | 0x01;
                    m_af.b.l = (val >> 7) | szp_table[result];
                    break;
                case 7: // SRL
                    result = val >> 1;
                    m_af.b.l = (val & CF) | szp_table[result];
                    break;
                default:
                    result = val;
                    break;
            }
            write_r8(reg, result);
            m_q = m_af.b.l;
            eat(is_hl ? 15 : 8);
            break;
        }

        case 0x40: { // BIT b,r
            uint8_t result = val & (1 << bit);
            // BIT sets Z if bit is 0, S if bit 7, PV=Z (parity of single-bit result)
            m_af.b.l = (m_af.b.l & CF) | HF |
                       (result ? (result & SF) : (ZF | PF)) |
                       (val & (YF | XF));
            if (is_hl) {
                // BIT n,(HL): Y and X come from high byte of WZ
                m_af.b.l = (m_af.b.l & ~(YF | XF)) | (m_wz.b.h & (YF | XF));
            }
            m_q = m_af.b.l;
            eat(is_hl ? 12 : 8);
            break;
        }

        case 0x80: // RES b,r
            write_r8(reg, val & ~(1 << bit));
            eat(is_hl ? 15 : 8);
            break;

        case 0xC0: // SET b,r
            write_r8(reg, val | (1 << bit));
            eat(is_hl ? 15 : 8);
            break;
    }
}
@

\section{ED Prefix: Extended Operations}

The ED prefix introduces block transfer/search/I/O operations, 16-bit
arithmetic with carry, I/O with flags, and interrupt mode selection.
Undefined ED opcodes are NOPs (8 T-states, 2 for the ED fetch + 2 for
the opcode fetch... actually undefined ED xx is treated as a two-byte NOP
consuming 8 T-states total).

<<z80 ed prefix>>=
void Z80::execute_ed()
{
    m_r = (m_r & 0x80) | ((m_r + 1) & 0x7F);
    uint8_t op = fetch();

    switch (op) {
        // IN r,(C) -- 0x40, 0x48, 0x50, 0x58, 0x60, 0x68, 0x70, 0x78
        case 0x40: case 0x48: case 0x50: case 0x58:
        case 0x60: case 0x68: case 0x70: case 0x78: {
            uint8_t val = io_read(m_bc.w);
            m_wz.w = m_bc.w + 1;
            int dst = (op >> 3) & 7;
            if (dst != 6) { // 0x70 = IN (HL) -- result discarded
                write_r8(dst, val);
            }
            m_af.b.l = (m_af.b.l & CF) | szp_table[val];
            m_q = m_af.b.l;
            eat(12);
            return;
        }

        // OUT (C),r -- 0x41, 0x49, 0x51, 0x59, 0x61, 0x69, 0x71, 0x79
        case 0x41: case 0x49: case 0x51: case 0x59:
        case 0x61: case 0x69: case 0x71: case 0x79: {
            int src = (op >> 3) & 7;
            uint8_t val = (src == 6) ? 0 : read_r8(src); // 0x71 = OUT (C),0
            io_write(m_bc.w, val);
            m_wz.w = m_bc.w + 1;
            eat(12);
            return;
        }

        // SBC HL,rr -- 0x42, 0x52, 0x62, 0x72
        case 0x42: case 0x52: case 0x62: case 0x72: {
            int pair = (op >> 4) & 3;
            alu_sbc16(reg16_sp(pair));
            eat(15);
            return;
        }

        // ADC HL,rr -- 0x4A, 0x5A, 0x6A, 0x7A
        case 0x4A: case 0x5A: case 0x6A: case 0x7A: {
            int pair = (op >> 4) & 3;
            alu_adc16(reg16_sp(pair));
            eat(15);
            return;
        }

        // LD (nn),rr -- 0x43, 0x53, 0x63, 0x73
        case 0x43: case 0x53: case 0x63: case 0x73: {
            uint16_t addr = fetch16();
            int pair = (op >> 4) & 3;
            uint16_t val = reg16_sp(pair);
            mem_write(addr, val & 0xFF);
            mem_write(addr + 1, val >> 8);
            m_wz.w = addr + 1;
            eat(20);
            return;
        }

        // LD rr,(nn) -- 0x4B, 0x5B, 0x6B, 0x7B
        case 0x4B: case 0x5B: case 0x6B: case 0x7B: {
            uint16_t addr = fetch16();
            int pair = (op >> 4) & 3;
            uint16_t& dst = reg16_sp(pair);
            dst = mem_read(addr) | (mem_read(addr + 1) << 8);
            m_wz.w = addr + 1;
            eat(20);
            return;
        }

        case 0x44: case 0x54: case 0x64: case 0x74:
        case 0x4C: case 0x5C: case 0x6C: case 0x7C: {
            // NEG (all are identical; official is 0x44, others undocumented)
            uint8_t old_a = m_af.b.h;
            m_af.b.h = 0;
            alu_sub(old_a);
            eat(8);
            return;
        }

        case 0x45: case 0x55: case 0x65: case 0x75:
        case 0x5D: case 0x6D: case 0x7D: // RETN
            m_iff1 = m_iff2;
            m_pc.b.l = mem_read(m_sp.w++);
            m_pc.b.h = mem_read(m_sp.w++);
            m_wz.w = m_pc.w;
            eat(14);
            return;

        case 0x4D: // RETI
            m_iff1 = m_iff2;
            m_pc.b.l = mem_read(m_sp.w++);
            m_pc.b.h = mem_read(m_sp.w++);
            m_wz.w = m_pc.w;
            eat(14);
            return;

        case 0x46: case 0x4E: case 0x66: case 0x6E: // IM 0
            m_im = 0;
            eat(8);
            return;

        case 0x56: case 0x76: // IM 1
            m_im = 1;
            eat(8);
            return;

        case 0x5E: case 0x7E: // IM 2
            m_im = 2;
            eat(8);
            return;

        case 0x47: // LD I,A
            m_i = m_af.b.h;
            eat(9);
            return;

        case 0x4F: // LD R,A
            m_r = m_af.b.h;
            eat(9);
            return;

        case 0x57: // LD A,I
            m_af.b.h = m_i;
            m_af.b.l = (m_af.b.l & CF) |
                       sz53_table[m_i] |
                       (m_iff2 ? PF : 0);
            m_q = m_af.b.l;
            eat(9);
            return;

        case 0x5F: // LD A,R
            m_af.b.h = m_r;
            m_af.b.l = (m_af.b.l & CF) |
                       sz53_table[m_r] |
                       (m_iff2 ? PF : 0);
            m_q = m_af.b.l;
            eat(9);
            return;

        case 0x67: { // RRD
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_hl.w, (m_af.b.h @<< 4) | (val >> 4));
            m_af.b.h = (m_af.b.h & 0xF0) | (val & 0x0F);
            m_af.b.l = (m_af.b.l & CF) | szp_table[m_af.b.h];
            m_q = m_af.b.l;
            m_wz.w = m_hl.w + 1;
            eat(18);
            return;
        }

        case 0x6F: { // RLD
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_hl.w, (val << 4) | (m_af.b.h & 0x0F));
            m_af.b.h = (m_af.b.h & 0xF0) | (val >> 4);
            m_af.b.l = (m_af.b.l & CF) | szp_table[m_af.b.h];
            m_q = m_af.b.l;
            m_wz.w = m_hl.w + 1;
            eat(18);
            return;
        }

        // Block transfer and search
        case 0xA0: { // LDI
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_de.w, val);
            m_hl.w++;
            m_de.w++;
            m_bc.w--;
            uint8_t n = val + m_af.b.h;
            m_af.b.l = (m_af.b.l & (SF | ZF | CF)) |
                       (m_bc.w != 0 ? PF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xA1: { // CPI
            uint8_t val = mem_read(m_hl.w);
            uint8_t result = m_af.b.h - val;
            uint8_t hf = ((m_af.b.h ^ val ^ result) & 0x10);
            m_hl.w++;
            m_bc.w--;
            uint8_t n = result - (hf ? 1 : 0);
            m_af.b.l = (m_af.b.l & CF) | NF |
                       (m_bc.w != 0 ? PF : 0) |
                       (hf ? HF : 0) |
                       (result & SF) |
                       (result == 0 ? ZF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            m_q = m_af.b.l;
            m_wz.w++;
            eat(16);
            return;
        }

        case 0xA2: { // INI
            uint8_t val = io_read(m_bc.w);
            m_wz.w = m_bc.w + 1;
            m_bc.b.h--;
            mem_write(m_hl.w, val);
            m_hl.w++;
            uint16_t k = val + ((m_bc.b.l + 1) & 0xFF);
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xA3: { // OUTI
            uint8_t val = mem_read(m_hl.w);
            m_bc.b.h--;
            io_write(m_bc.w, val);
            m_hl.w++;
            m_wz.w = m_bc.w + 1;
            uint16_t k = val + m_hl.b.l;
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xA8: { // LDD
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_de.w, val);
            m_hl.w--;
            m_de.w--;
            m_bc.w--;
            uint8_t n = val + m_af.b.h;
            m_af.b.l = (m_af.b.l & (SF | ZF | CF)) |
                       (m_bc.w != 0 ? PF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xA9: { // CPD
            uint8_t val = mem_read(m_hl.w);
            uint8_t result = m_af.b.h - val;
            uint8_t hf = ((m_af.b.h ^ val ^ result) & 0x10);
            m_hl.w--;
            m_bc.w--;
            uint8_t n = result - (hf ? 1 : 0);
            m_af.b.l = (m_af.b.l & CF) | NF |
                       (m_bc.w != 0 ? PF : 0) |
                       (hf ? HF : 0) |
                       (result & SF) |
                       (result == 0 ? ZF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            m_q = m_af.b.l;
            m_wz.w--;
            eat(16);
            return;
        }

        case 0xAA: { // IND
            uint8_t val = io_read(m_bc.w);
            m_wz.w = m_bc.w - 1;
            m_bc.b.h--;
            mem_write(m_hl.w, val);
            m_hl.w--;
            uint16_t k = val + ((m_bc.b.l - 1) & 0xFF);
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xAB: { // OUTD
            uint8_t val = mem_read(m_hl.w);
            m_bc.b.h--;
            io_write(m_bc.w, val);
            m_hl.w--;
            m_wz.w = m_bc.w - 1;
            uint16_t k = val + m_hl.b.l;
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            m_q = m_af.b.l;
            eat(16);
            return;
        }

        case 0xB0: { // LDIR
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_de.w, val);
            m_hl.w++;
            m_de.w++;
            m_bc.w--;
            uint8_t n = val + m_af.b.h;
            m_af.b.l = (m_af.b.l & (SF | ZF | CF)) |
                       (m_bc.w != 0 ? PF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            if (m_bc.w != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X flags come from PC bits
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xB1: { // CPIR
            uint8_t val = mem_read(m_hl.w);
            uint8_t result = m_af.b.h - val;
            uint8_t hf = ((m_af.b.h ^ val ^ result) & 0x10);
            m_hl.w++;
            m_bc.w--;
            uint8_t n = result - (hf ? 1 : 0);
            m_af.b.l = (m_af.b.l & CF) | NF |
                       (m_bc.w != 0 ? PF : 0) |
                       (hf ? HF : 0) |
                       (result & SF) |
                       (result == 0 ? ZF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            if (m_bc.w != 0 && result != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X flags come from PC bits
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                eat(21);
            } else {
                m_wz.w++;
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xB2: { // INIR
            uint8_t val = io_read(m_bc.w);
            m_wz.w = m_bc.w + 1;
            m_bc.b.h--;
            mem_write(m_hl.w, val);
            m_hl.w++;
            uint16_t k = val + ((m_bc.b.l + 1) & 0xFF);
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            if (m_bc.b.h != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X from PC bits, PF/HF adjusted
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                if (m_af.b.l & CF) {
                    if (val & 0x80) {
                        if (!parity_table[(m_bc.b.h - 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x00 ? HF : 0);
                    } else {
                        if (!parity_table[(m_bc.b.h + 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x0F ? HF : 0);
                    }
                } else {
                    if (!parity_table[m_bc.b.h & 7]) m_af.b.l ^= PF;
                }
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xB3: { // OTIR
            uint8_t val = mem_read(m_hl.w);
            m_bc.b.h--;
            io_write(m_bc.w, val);
            m_hl.w++;
            m_wz.w = m_bc.w + 1;
            uint16_t k = val + m_hl.b.l;
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            if (m_bc.b.h != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X from PC bits, PF/HF adjusted
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                if (m_af.b.l & CF) {
                    if (val & 0x80) {
                        if (!parity_table[(m_bc.b.h - 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x00 ? HF : 0);
                    } else {
                        if (!parity_table[(m_bc.b.h + 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x0F ? HF : 0);
                    }
                } else {
                    if (!parity_table[m_bc.b.h & 7]) m_af.b.l ^= PF;
                }
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xB8: { // LDDR
            uint8_t val = mem_read(m_hl.w);
            mem_write(m_de.w, val);
            m_hl.w--;
            m_de.w--;
            m_bc.w--;
            uint8_t n = val + m_af.b.h;
            m_af.b.l = (m_af.b.l & (SF | ZF | CF)) |
                       (m_bc.w != 0 ? PF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            if (m_bc.w != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X flags come from PC bits
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xB9: { // CPDR
            uint8_t val = mem_read(m_hl.w);
            uint8_t result = m_af.b.h - val;
            uint8_t hf = ((m_af.b.h ^ val ^ result) & 0x10);
            m_hl.w--;
            m_bc.w--;
            uint8_t n = result - (hf ? 1 : 0);
            m_af.b.l = (m_af.b.l & CF) | NF |
                       (m_bc.w != 0 ? PF : 0) |
                       (hf ? HF : 0) |
                       (result & SF) |
                       (result == 0 ? ZF : 0) |
                       (n & XF) |
                       ((n & 0x02) ? YF : 0);
            if (m_bc.w != 0 && result != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X flags come from PC bits
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                eat(21);
            } else {
                m_wz.w--;
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xBA: { // INDR
            uint8_t val = io_read(m_bc.w);
            m_wz.w = m_bc.w - 1;
            m_bc.b.h--;
            mem_write(m_hl.w, val);
            m_hl.w--;
            uint16_t k = val + ((m_bc.b.l - 1) & 0xFF);
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            if (m_bc.b.h != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X from PC bits, PF/HF adjusted
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                if (m_af.b.l & CF) {
                    if (val & 0x80) {
                        if (!parity_table[(m_bc.b.h - 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x00 ? HF : 0);
                    } else {
                        if (!parity_table[(m_bc.b.h + 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x0F ? HF : 0);
                    }
                } else {
                    if (!parity_table[m_bc.b.h & 7]) m_af.b.l ^= PF;
                }
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        case 0xBB: { // OTDR
            uint8_t val = mem_read(m_hl.w);
            m_bc.b.h--;
            io_write(m_bc.w, val);
            m_hl.w--;
            m_wz.w = m_bc.w - 1;
            uint16_t k = val + m_hl.b.l;
            m_af.b.l = sz53_table[m_bc.b.h] |
                       (val & SF ? NF : 0) |
                       ((k > 255) ? (HF | CF) : 0) |
                       parity_table[(k & 7) ^ m_bc.b.h];
            if (m_bc.b.h != 0) {
                m_pc.w -= 2;
                m_wz.w = m_pc.w + 1;
                // Repeat: Y/X from PC bits, PF/HF adjusted
                m_af.b.l = (m_af.b.l & ~(YF | XF)) |
                           ((m_pc.w & (1 << 13)) ? YF : 0) |
                           ((m_pc.w & (1 << 11)) ? XF : 0);
                if (m_af.b.l & CF) {
                    if (val & 0x80) {
                        if (!parity_table[(m_bc.b.h - 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x00 ? HF : 0);
                    } else {
                        if (!parity_table[(m_bc.b.h + 1) & 7]) m_af.b.l ^= PF;
                        m_af.b.l = (m_af.b.l & ~HF) | ((m_bc.b.h & 0x0F) == 0x0F ? HF : 0);
                    }
                } else {
                    if (!parity_table[m_bc.b.h & 7]) m_af.b.l ^= PF;
                }
                eat(21);
            } else {
                eat(16);
            }
            m_q = m_af.b.l;
            return;
        }

        default:
            // Undefined ED opcodes are two-byte NOPs
            eat(8);
