\subsection{Initialization}

Create an SDL window at the configured scale, with a renderer that uses
vsync for frame pacing.  The texture is 256x256 pixels, streaming mode,
RGBA8888 pixel format.

<<platform init implementation>>=
bool platform_init(const PlatformConfig& config, PlatformHandles& handles)
{
    if (SDL_Init(SDL_INIT_VIDEO) < 0) {
        std::fprintf(stderr, "SDL_Init failed: %s\n", SDL_GetError());
        return false;
    }

    int w = 256 * config.scale;
    int h = 224 * config.scale;  // visible area only

    handles.window = SDL_CreateWindow(
        config.title,
        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
        w, h,
        SDL_WINDOW_SHOWN
    );
    if (!handles.window) {
        std::fprintf(stderr, "SDL_CreateWindow failed: %s\n", SDL_GetError());
        SDL_Quit();
        return false;
    }

    handles.renderer = SDL_CreateRenderer(
        handles.window, -1,
        SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC
    );
    if (!handles.renderer) {
        std::fprintf(stderr, "SDL_CreateRenderer failed: %s\n", SDL_GetError());
        SDL_DestroyWindow(handles.window);
        SDL_Quit();
        return false;
    }

    // 256x256 texture (full framebuffer including vblank lines)
    handles.texture = SDL_CreateTexture(
        handles.renderer,
        SDL_PIXELFORMAT_RGBA8888,
        SDL_TEXTUREACCESS_STREAMING,
        256, 256
    );
    if (!handles.texture) {
        std::fprintf(stderr, "SDL_CreateTexture failed: %s\n", SDL_GetError());
        SDL_DestroyRenderer(handles.renderer);
        SDL_DestroyWindow(handles.window);
        SDL_Quit();
        return false;
    }

    return true;
}
@

\subsection{Shutdown}

<<platform shutdown implementation>>=
void platform_shutdown(PlatformHandles& handles)
{
    if (handles.texture) {
        SDL_DestroyTexture(handles.texture);
        handles.texture = nullptr;
    }
    if (handles.renderer) {
        SDL_DestroyRenderer(handles.renderer);
        handles.renderer = nullptr;
    }
    if (handles.window) {
        SDL_DestroyWindow(handles.window);
        handles.window = nullptr;
    }
    SDL_Quit();
}
@

\subsection{Input Polling}

Poll all pending SDL events and then sample the keyboard state.  Each
mapped key clears the corresponding bit in the active-low port bytes.

The keyboard state is sampled after event processing to get the current
state of all keys, rather than tracking individual key-down/key-up events.
This is simpler and matches how the real hardware reads port state (it
samples the button lines at the moment of the IN instruction).

<<poll input implementation>>=
bool poll_input(InputState& input)
{
    SDL_Event event;
    while (SDL_PollEvent(&event)) {
        if (event.type == SDL_QUIT) {
            return false;
        }
    }

    const uint8_t* keys = SDL_GetKeyboardState(nullptr);

    // Escape quits
    if (keys[SDL_SCANCODE_ESCAPE]) {
        return false;
    }

    // Start with all bits high (no buttons pressed)
    input.port_48 = 0xFF;
    input.port_49 = 0xFF;
    input.port_4a = 0xFF;

    // P1 controls -> port 0x48
    if (keys[SDL_SCANCODE_LEFT])   input.port_48 &= ~0x01;  // bit 0: left
    if (keys[SDL_SCANCODE_RIGHT])  input.port_48 &= ~0x02;  // bit 1: right
    if (keys[SDL_SCANCODE_UP])     input.port_48 &= ~0x04;  // bit 2: up
    if (keys[SDL_SCANCODE_DOWN])   input.port_48 &= ~0x08;  // bit 3: down
    if (keys[SDL_SCANCODE_LCTRL] || keys[SDL_SCANCODE_SPACE]) {
        input.port_48 &= ~0x10;  // bit 4: fire
    }

    // System controls -> port 0x49
    if (keys[SDL_SCANCODE_1])  input.port_49 &= ~0x01;  // bit 0: 1P start
    if (keys[SDL_SCANCODE_2])  input.port_49 &= ~0x02;  // bit 1: 2P start
    if (keys[SDL_SCANCODE_5])  input.port_49 &= ~0x80;  // bit 7: coin 1

    return true;
}
@

\subsection{Texture Upload}

Upload the 256x256 RGBA framebuffer to the SDL streaming texture.
Each pixel is a 32-bit value packed as 0xRRGGBBAA.

<<update texture implementation>>=
void update_texture(SDL_Texture* texture, const uint32_t* framebuffer)
{
    SDL_UpdateTexture(texture, nullptr, framebuffer, 256 * sizeof(uint32_t));
}
@

\subsection{Frame Presentation}

Render the texture to screen, cropping to visible scanlines 32--255
(224 lines).  The source rect selects those lines from the 256-line
texture.  The destination is the full window.

<<present frame implementation>>=
void present_frame(SDL_Renderer* renderer, SDL_Texture* texture)
{
    SDL_RenderClear(renderer);

    // Source rect: skip the 32 vblank lines at the top, show 224 visible lines
    SDL_Rect src = { 0, 32, 256, 224 };
    SDL_RenderCopy(renderer, texture, &src, nullptr);

    SDL_RenderPresent(renderer);
}
@

