\subsection{Maze Generation}

Exact reimplementation of the ROM maze generator at \$2540--\$2677.
This is deterministic: given the same (room\_x, room\_y), it produces
the identical VRAM content as the emulated Z80 code.

<<native maze generation>>=
void BerzerkNative::draw_horizontal_segment(uint8_t y, uint8_t x)
{
    for (int i = 0; i < 12; i++) {
        draw_wall_tile(y, x);
        x += 4;
    }
}

void BerzerkNative::draw_vertical_segment(uint8_t y, uint8_t x)
{
    for (int i = 0; i < 18; i++) {
        draw_wall_tile(y, x);
        y += 4;
    }
}
@

<<native border walls>>=
void BerzerkNative::draw_borders()
{
    // Horizontal border wall with gap: 48 + 48 + 48gap + 48 + 48
    auto draw_horiz_gap = [&](uint8_t y, uint8_t x) {
        draw_horizontal_segment(y, x);
        x += 48;
        draw_horizontal_segment(y, x);
        x += 48;
        x += 48;  // gap (doorway)
        draw_horizontal_segment(y, x);
        x += 48;
        draw_horizontal_segment(y, x);
    };

    // Vertical border wall with gap: 72 + 64gap + 72
    auto draw_vert_gap = [&](uint8_t y, uint8_t x) {
        draw_vertical_segment(y, x);
        y += 72 + 64;  // wall + gap
        draw_vertical_segment(y, x);
    };

    draw_horiz_gap(0x00, 0x08);   // top border
    draw_horiz_gap(0xCC, 0x08);   // bottom border
    draw_vert_gap(0x00, 0x04);    // left border
    draw_vert_gap(0x00, 0xF8);    // right border
}

void BerzerkNative::generate_maze()
{
    // 1. Seed RNG from room coordinates
    m_state.rng_seed = (static_cast<uint16_t>(m_state.room_y) @<< 8) |
                        m_state.room_x;

    // 2. Copy wall template to config buffer
    std::memcpy(m_state.maze_config, WALL_TEMPLATE, 15);

    // 3. Clear the maze area in VRAM
    // Original clears a 12x12 byte rect at $5E6A (upright)
    // For simplicity, we clear the whole screen since we are about to draw everything
    clear_screen();

    // 4. Draw border walls with doorways
    draw_borders();

    // 5. Generate interior walls (two passes: top half and bottom half)
    int ix_offset = 0;

    for (int half = 0; half < 2; half++) {
        uint8_t base_y = (half == 0) ? 0x44 : 0x88;
        uint8_t x = 0x38;

        while (true) {
            random();  // first call (advances state, result unused for dispatch)
            uint8_t r = random();  // second call
            uint8_t wall_type = r & 0x03;

            switch (wall_type) {
            case 0:  // extends UP
                draw_vertical_segment(
                    static_cast<uint8_t>(base_y - 0x44), x);
                m_state.maze_config[ix_offset] |= 0x02;
                m_state.maze_config[ix_offset + 1] |= 0x01;
                break;
            case 1:  // extends DOWN
                draw_vertical_segment(base_y, x);
                m_state.maze_config[ix_offset + 5] |= 0x02;
                m_state.maze_config[ix_offset + 6] |= 0x01;
                break;
            case 2:  // extends RIGHT
                draw_horizontal_segment(base_y, x);
                m_state.maze_config[ix_offset + 1] |= 0x08;
                m_state.maze_config[ix_offset + 6] |= 0x04;
                break;
            case 3:  // extends LEFT
                draw_horizontal_segment(base_y,
                    static_cast<uint8_t>(x - 0x30));
                m_state.maze_config[ix_offset] |= 0x08;
                m_state.maze_config[ix_offset + 5] |= 0x04;
                break;
            }

            ix_offset++;
            x += 0x30;
            if (x >= 0xDC) {
                ix_offset++;  // skip right border byte
                break;
            }
        }
    }
}
@

\subsection{Character Printing}

Exact reimplementation of PRINT\_CHAR at \$29DB. Each character is 9 bytes in
the font ROM at \$2F1E, indexed by ordinal. If bit~7 of the first font byte is
set, the character is drawn 3 scanlines lower. Each scanline: write the font
byte (with bit~7 masked off) through the Magic~RAM pipeline, then write a
\$00 flush byte to clear the shift register.

<<native print char>>=
void BerzerkNative::print_char(uint8_t c, uint16_t dest_addr)
{
    if (!m_charset) return;

    const uint8_t* font = &m_charset[static_cast<unsigned>(c) * 9];
    uint16_t vram_offset = dest_addr - 0x6000;

    // Bit 7 of first byte: shift 3 scanlines down ($0060 = 3 * $20)
    if (font[0] & 0x80) {
        vram_offset += 0x0060;
    }

    // Draw 9 rows
    for (int row = 0; row < 9; row++) {
        uint8_t data = font[row] & 0x7F;
        magic_ram_write(m_video, vram_offset, data);
        magic_ram_write(m_video, vram_offset + 1, 0x00);  // flush
        vram_offset += 0x20;  // next scanline (32 bytes per row)
    }
}
@

\subsection{Digit Printing}

Reimplementation of PRINT\_DIGITS at \$2A40. Prints a BCD-encoded number
with leading-space suppression. Each BCD byte holds two digits (upper nibble
first). The last digit is always shown even if zero.

<<native print digits>>=
void BerzerkNative::print_digits(const uint8_t* bcd_data, int num_digits,
                                  uint8_t y, uint8_t x)
{
    // Set magic RAM control: mode 0 (direct write) + shift from X
    uint8_t shift = x & 0x07;
    m_video.magic.control = shift;
    m_video.magic.last_shift_data = 0;
    m_video.magic.intercept = 1;

    uint16_t dest = calc_magic_ram_addr(y, x);

    bool pad_with_spaces = true;

    for (int i = 0; i < num_digits; i++) {
        int remaining = num_digits - i;
        if (remaining == 1) {
            pad_with_spaces = false;
        }

        // Extract BCD digit: even index = upper nibble, odd = lower nibble
        uint8_t digit;
        if ((i & 1) == 0) {
            digit = (bcd_data[i / 2] >> 4) & 0x0F;
        } else {
            digit = bcd_data[i / 2] & 0x0F;
        }

        uint8_t ch;
        if (digit == 0 && pad_with_spaces) {
            ch = 0x20;  // space
        } else {
            pad_with_spaces = false;
            ch = 0x30 + digit;  // ASCII '0' + digit
            if (ch >= 0x3A) ch += 7;  // hex digits A-F
        }

        print_char(ch, dest);
        dest++;  // next character position (1 byte = 8 pixels)
    }
}
@

\subsection{Score Display}

Reimplementation of SHOW\_SCORE at \$2314. Prints P1 score (6 BCD digits)
at screen position Y=\$D5, X=\$00. In two-player mode, also prints P2 score
at Y=\$D5, X=\$B0 (not implemented yet).

<<native show score>>=
void BerzerkNative::show_score()
{
    // P1 score at (Y=$D5, X=$00), 6 digits, 3 BCD bytes
    print_digits(m_state.score, 6, 0xD5, 0x00);
}
