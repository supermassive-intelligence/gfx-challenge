    uint8_t difficulty = 0;        // $434A (BCD, +$60 per room)
    uint8_t rbolts = 0;            // $434B
    uint8_t robot_speed = 8;       // $434C
    uint8_t rwait = 80;            // $434D
    uint8_t otto_time = 0;         // $434E
    uint8_t xtramen = 0;           // $434F

    // RNG ($435C)
    uint16_t rng_seed = 0;

    // Maze config ($435E, 15 bytes)
    uint8_t maze_config[15] = {};

    // Score ($433E-$4340, BCD)
    uint8_t score[3] = {0, 0, 0};

    // Game flags
    uint8_t is_demo_mode = 0;      // $436E
    uint8_t update_flag = 0;       // $436D
    uint8_t rcount = 0;            // $4371 (robots alive)
    uint8_t rsaved = 0;            // $4372
    uint8_t flip = 0;              // $4379 (0=upright, 8=cocktail)
