\subsection{Robot Spawning}

Reimplementation of the ROM robot spawning at \$2117--\$2154.

<<native spawn robots>>=
void BerzerkNative::spawn_robots()
{
    m_state.rcount = 0;
    m_state.rsaved = 0;

    for (int i = 0; i < MAX_ROBOTS; i++) {
        m_state.robots[i].active = false;
    }

    for (int slot = 0; slot < MAX_ROBOTS; slot++) {
        uint8_t r = random();

        // Spawn probability check: r >= difficulty threshold
        if (r < m_state.difficulty) continue;

        // Spawn at position from table, jittered
        uint8_t base_x = SPAWN_POSITIONS[slot][0];
        uint8_t base_y = SPAWN_POSITIONS[slot][1];
        uint8_t jitter_x = random() & 0x1F;  // 0-31
        uint8_t jitter_y = random() & 0x1F;

        Vector& robot = m_state.robots[slot];
        robot.active = true;
        robot.px = base_x + jitter_x;
        robot.py = base_y + jitter_y;
        robot.vx = 0;
        robot.vy = 0;
        robot.status = STATUS_WRITE | STATUS_MOVE;  // $06
        robot.time = 1;
        robot.tprime = m_state.robot_speed;
        // Pattern pointer: robot standing ($1000 in ROM)
        robot.pattern_ptr = 0x1000;

        m_state.rcount++;
        m_state.rsaved++;
    }

    // Calculate Otto timer
    m_state.otto_time = m_state.robot_speed + m_state.rsaved + m_state.rbolts;
}
@

\subsection{Frame Logic}

Each frame: process input, run game logic, render sprites.

<<native frame logic>>=
void BerzerkNative::step_frame()
{
    switch (m_state.phase) {
    case GameState::Phase::BOOT:
        m_state.phase = GameState::Phase::ATTRACT;
        break;

    case GameState::Phase::ATTRACT:
        do_frame_attract();
        break;

    case GameState::Phase::GAME_INIT:
        m_state.deaths = 3;
        m_state.score[0] = m_state.score[1] = m_state.score[2] = 0;
        m_state.difficulty = 0;
        m_state.robot_speed = 8;
        m_state.rwait = 80;
        m_state.xtramen = 0;
        m_state.room_x = random();
        m_state.room_y = random();
        m_state.man_x = 0x80;
        m_state.man_y = 0x60;
        m_state.phase = GameState::Phase::ROOM_SETUP;
        break;

    case GameState::Phase::ROOM_SETUP:
        do_room_setup();
        break;

    case GameState::Phase::PLAYING:
        do_frame_playing();
        break;

    case GameState::Phase::PLAYER_DEAD:
        m_state.phase_timer--;
        if (m_state.phase_timer <= 0) {
            m_state.deaths--;
            if (m_state.deaths == 0) {
                m_state.phase = GameState::Phase::GAME_OVER;
            } else {
                m_state.man_x = 0x80;
                m_state.man_y = 0x60;
                m_state.phase = GameState::Phase::ROOM_SETUP;
            }
        }
        break;

    case GameState::Phase::ROOM_CLEAR:
        m_state.phase_timer--;
        if (m_state.phase_timer <= 0) {
            // Advance room
            m_state.room_x++;
            m_state.difficulty = static_cast<uint8_t>(
                m_state.difficulty + 0x60);  // BCD add wraps
            if (m_state.robot_speed > 1) m_state.robot_speed--;
            if (m_state.rwait > 20) m_state.rwait -= 10;
            m_state.man_x = 0x08;
            m_state.man_y = 0x60;
            m_state.phase = GameState::Phase::ROOM_SETUP;
        }
        break;

    case GameState::Phase::GAME_OVER:
        m_state.phase_timer--;
        if (m_state.phase_timer <= 0) {
            m_state.phase = GameState::Phase::ATTRACT;
        }
        break;
    }

    m_state.frame_number++;
}

void BerzerkNative::do_frame_attract()
{
    // Check for coin + start
    if ((m_input.port_49 & 0x80) == 0) {  // coin inserted (active low)
        // Wait for 1P start
        if ((m_input.port_49 & 0x01) == 0) {
            m_state.phase = GameState::Phase::GAME_INIT;
        }
    }
}

void BerzerkNative::do_frame_playing()
{
    // Process player input -> set velocity on player VECTOR
    uint8_t joy = m_input.port_48;
    int8_t dx = 0, dy = 0;
    if ((joy & 0x01) == 0) dx = -1;  // left
    if ((joy & 0x02) == 0) dx = 1;   // right
    if ((joy & 0x04) == 0) dy = -1;  // up
    if ((joy & 0x08) == 0) dy = 1;   // down
    m_state.player.vx = dx;
    m_state.player.vy = dy;

    // Run sprite pipeline on player
    erase_pattern(m_state.player);
    move_animate_vector(m_state.player);
    write_pattern(m_state.player);

    // Run sprite pipeline on each active robot
    for (int i = 0; i < MAX_ROBOTS; i++) {
        if (!m_state.robots[i].active) continue;
        erase_pattern(m_state.robots[i]);
        move_animate_vector(m_state.robots[i]);
        write_pattern(m_state.robots[i]);
    }

    // Check room exit
    check_room_exit();

    // Check if all robots dead
    if (m_state.rcount == 0 && m_state.phase == GameState::Phase::PLAYING) {
        m_state.phase = GameState::Phase::ROOM_CLEAR;
        m_state.phase_timer = 60;
    }
}

void BerzerkNative::check_room_exit()
{
    uint8_t x = m_state.player.px;
    uint8_t y = m_state.player.py;

    if (x >= EXIT_RIGHT_X) {
        m_state.room_x++;
        m_state.man_x = 0x08;
        m_state.man_y = y;
        m_state.phase = GameState::Phase::ROOM_SETUP;
    } else if (x >= EXIT_LEFT_X) {
        m_state.room_x--;
        m_state.man_x = 0xF0;
        m_state.man_y = y;
        m_state.phase = GameState::Phase::ROOM_SETUP;
    } else if (y < EXIT_TOP_Y) {
        m_state.room_y--;
        m_state.man_x = x;
        m_state.man_y = 0xBC;
        m_state.phase = GameState::Phase::ROOM_SETUP;
    } else if (y >= EXIT_BOTTOM_Y) {
        m_state.room_y++;
        m_state.man_x = x;
        m_state.man_y = 0x04;
        m_state.phase = GameState::Phase::ROOM_SETUP;
    }
}
@

\subsection{Snapshot and Restore}

<<native snapshot restore>>=
MachineSnapshot BerzerkNative::snapshot() const
{
    MachineSnapshot snap;
    snap.cpu = {};  // no CPU state in native implementation
    snap.work_ram.fill(0);

    // Pack game state into work_ram at the canonical addresses
    // This is a simplified mapping for cosimulation
    snap.work_ram[0x0345 - 0x0800] = m_state.room_x;  // but this is scratch RAM range
    // For now, VRAM comparison is the primary verification mechanism.

    snap.vram = m_video.vram;
    snap.color_ram = m_video.color_ram;
    snap.magic_control = m_video.magic.control;
    snap.magic_intercept = m_video.magic.intercept;
    snap.nmi_enabled = m_interrupts.nmi_enabled;
    snap.irq_enabled = m_interrupts.irq_enabled;
    snap.frame_number = m_state.frame_number;

    return snap;
}

void BerzerkNative::restore(const MachineSnapshot& snap)
{
    m_video.vram = snap.vram;
    m_video.color_ram = snap.color_ram;
    m_video.magic.control = snap.magic_control;
    m_video.magic.intercept = snap.magic_intercept;
    m_state.frame_number = snap.frame_number;
}
