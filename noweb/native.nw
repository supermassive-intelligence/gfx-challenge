bool BerzerkNative::init(const char* rom_dir)
{
    // Load program ROMs (we need pattern data and character set)
    static const std::vector<RomDescriptor> roms = {
        {"berzerk_rc31_1c.rom0.1c",   0x0000, 0x0800, 0xca566dbc},
        {"berzerk_rc31_1d.rom1.1d",   0x1000, 0x0800, 0x7ba69fde},
        {"berzerk_rc31_3d.rom2.3d",   0x1800, 0x0800, 0xa1d5248b},
        {"berzerk_rc31_5d.rom3.5d",   0x2000, 0x0800, 0xfcaefa95},
        {"berzerk_rc31_6d.rom4.6d",   0x2800, 0x0800, 0x1e35b9a0},
        {"berzerk_rc31a_5c.rom5.5c",  0x3000, 0x0800, 0xe0fab8f5},
    };

    if (!load_roms(rom_dir, roms, m_program_rom, 0x4000)) {
        std::fprintf(stderr, "BerzerkNative: failed to load ROMs\n");
        return false;
    }

    m_patterns = &m_program_rom[0x1000];
    m_charset = &m_program_rom[0x2F1E];

    reset();
    return true;
}
