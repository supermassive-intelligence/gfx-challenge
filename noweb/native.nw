<<native reset>>=
void BerzerkNative::reset()
{
    m_video.vram.fill(0);
    m_video.color_ram.fill(0);
    m_video.magic = MagicRAMControl{};
    m_state = GameState{};
    m_state.phase = GameState::Phase::ATTRACT;
}
