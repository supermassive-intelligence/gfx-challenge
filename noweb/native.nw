    Vector robots[MAX_ROBOTS];
    Vector otto;
    Bolt player_bolts[2];
    Bolt robot_bolts[8];

    // Frame tracking
    int frame_number = 0;

    // Game phase state machine (replaces Z80 coroutine scheduler)
    enum class Phase {
        BOOT,
        ATTRACT,
        GAME_INIT,
        ROOM_SETUP,
        PLAYING,
        PLAYER_DEAD,
        ROOM_CLEAR,
        GAME_OVER,
    } phase = Phase::BOOT;

