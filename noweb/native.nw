\subsection{Random Number Generator}

Exact replica of the ROM routine at \$2678: [[seed = seed * 7 + \$3153]].
Returns the high byte of the new seed.

<<native rng>>=
uint8_t BerzerkNative::random()
{
    m_state.rng_seed = static_cast<uint16_t>(
        (m_state.rng_seed * 7 + 0x3153) & 0xFFFF);
    return static_cast<uint8_t>(m_state.rng_seed >> 8);
}
@

\subsection{Coordinate Conversion}

Convert (Y, X) screen coordinates to a Magic RAM address. The original
routine is CALCULATE\_MAGIC\_IMAGE\_RAM\_ADDRESS at \$29A3. The formula is:
\begin{verbatim}
vram_offset = (Y * 32) + (X / 8)
magic_addr = 0x6000 + vram_offset
\end{verbatim}

The Magic RAM control register is set to configure the 74181 ALU mode and
the pixel shift amount (X \% 8).

<<native coordinate conversion>>=
uint16_t BerzerkNative::calc_magic_ram_addr(uint8_t y, uint8_t x)
{
    // Replicate CALCULATE_MAGIC_IMAGE_RAM_ADDRESS at $29A3:
    // HL = (Y * 256) | X, then HL shifts right 3, then HL += $6400.
    // The $6400 base (not $6000) accounts for the 32-line vblank gap.
    uint16_t hl = (static_cast<uint16_t>(y) @<< 8) | x;
    hl >>= 3;
    return 0x6400 + hl;
}
@

\subsection{Sprite Drawing}

Draw a sprite through the Magic RAM pipeline. This replicates DRAW\_SPRITE
at \$2817. The frame data format is [width][height][pixel bytes...].
The [[dest\_addr]] is a Magic RAM address (0x6000--0x7FFF).

The Z80 code handles two modes: 1-byte wide (stride \$1F after data+flush)
and 2-byte wide (stride \$1E after 2 data bytes + flush). We only support
upright cabinet (FLIP=0).

<<native sprite drawing>>=
void BerzerkNative::draw_sprite(const uint8_t* frame_data, uint16_t dest_addr)
{
    uint8_t width = frame_data[0];
    uint8_t height = frame_data[1];
    const uint8_t* pixels = &frame_data[2];

    uint16_t vram_offset = dest_addr - 0x6000;

    if (width == 1) {
        // 1-byte wide: stride = 32 - 1 (data) = $1F after flush
        for (int row = 0; row < height; row++) {
            magic_ram_write(m_video, vram_offset, pixels[row]);
            magic_ram_write(m_video, vram_offset + 1, 0x00);
            vram_offset += BYTES_PER_ROW;
        }
    } else {
        // 2-byte wide: stride = 32 - 2 (data) = $1E after flush
        for (int row = 0; row < height; row++) {
            magic_ram_write(m_video, vram_offset, pixels[row * 2]);
            magic_ram_write(m_video, vram_offset + 1, pixels[row * 2 + 1]);
            magic_ram_write(m_video, vram_offset + 2, 0x00);
            vram_offset += BYTES_PER_ROW;
        }
    }
}

void BerzerkNative::draw_wall_tile(uint8_t y, uint8_t x)
{
    // Set magic RAM control: $10 = OR mode, shift = x % 8
    uint8_t shift = x & 0x07;
    m_video.magic.control = 0x10 | shift;
    m_video.magic.last_shift_data = 0;
    m_video.magic.intercept = 1;

    uint16_t addr = calc_magic_ram_addr(y, x);
    draw_sprite(WALL_SPRITE, addr);
}
@

