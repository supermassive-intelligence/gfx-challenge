\section{Input Recording}

A recorded input sequence is a vector of per-frame [[InputState]] values.
This enables deterministic replay: both implementations receive identical
inputs on each frame.

<<input recording>>=
struct InputRecording {
    std::vector<InputState> frames;

    void record_frame(const InputState& input) {
        frames.push_back(input);
    }

    const InputState& get_frame(int frame_number) const {
        if (frame_number >= 0 &&
            frame_number < static_cast<int>(frames.size())) {
            return frames[frame_number];
        }
        // Default: no buttons pressed
        static const InputState default_input;
        return default_input;
    }

    int num_frames() const {
        return static_cast<int>(frames.size());
    }
};

bool save_input_recording(const InputRecording& rec, const char* path);
bool load_input_recording(InputRecording& rec, const char* path);
@

\section{Comparison Result}

The result of comparing two [[FrameLog]] structures.

<<comparison result>>=
struct ComparisonResult {
    bool match = true;                  // overall pass/fail
    int first_divergent_frame = -1;     // frame where first difference found

    // Subroutine-level divergences
    int invocation_mismatches = 0;      // different invocation sequences
    int event_set_mismatches = 0;       // same invocation, different events

    // Frame-level divergences
    int vram_byte_mismatches = 0;       // bytes that differ in final VRAM
    int intercept_mismatches = 0;       // collision flag differences

    // Statistics
    int frames_compared = 0;
    int total_invocations = 0;

    void print_summary() const;
};

// Compare two frame logs.
ComparisonResult compare_frame_logs(const FrameLog& a, const FrameLog& b);

// Compare invocation sequences (ordered).
bool compare_invocation_sequences(
    const std::vector<InvocationRecord>& a,
    const std::vector<InvocationRecord>& b,
    int& first_mismatch_index);

// Compare event sets within a single invocation (unordered).
bool compare_event_sets(
    const std::vector<EventRecord>& a,
    const std::vector<EventRecord>& b);
@

\section{Cosimulation Runner}

The runner orchestrates the side-by-side execution.

<<cosim runner>>=
class CosimRunner {
public:
    // Takes ownership of neither machine.
    CosimRunner(BerzerkMachine& reference, BerzerkMachine& candidate);

    // Run N frames, comparing at each frame boundary.
    // Uses the provided input recording (or default inputs if null).
    ComparisonResult run(int num_frames, const InputRecording* inputs = nullptr);

    // Run with live input recording (for capturing test data).
    ComparisonResult run_and_record(int num_frames,
                                     InputRecording& recording,
                                     const InputState& live_input);

private:
    BerzerkMachine& m_reference;
    BerzerkMachine& m_candidate;
};
