\subsection{Load Entry Points}

Parse the [[subroutine\_entry\_points.txt]] file, extracting hex addresses.
Lines starting with [[;]] are comments. Each data line has a hex address
as the first token.

<<load entry points implementation>>=
bool load_entry_points(const char* path, SubroutineEntryPoints& ep)
{
    std::ifstream file(path);
    if (!file.is_open()) {
        std::fprintf(stderr, "Cannot open entry points file: %s\n", path);
        return false;
    }

    std::string line;
    while (std::getline(file, line)) {
        // Skip empty lines and comments
        if (line.empty() || line[0] == ';') continue;

        // Parse hex address (first token)
        uint32_t addr = 0;
        std::istringstream iss(line);
        std::string token;
        if (iss >> token) {
            if (std::sscanf(token.c_str(), "0x%x", &addr) == 1 ||
                std::sscanf(token.c_str(), "$%x", &addr) == 1 ||
                std::sscanf(token.c_str(), "%x", &addr) == 1) {
                ep.add(static_cast<uint16_t>(addr));
            }
        }
    }

    std::fprintf(stderr, "Loaded %d subroutine entry points from %s\n",
                 ep.count, path);
    return ep.count > 0;
}
