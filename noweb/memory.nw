\subsection{CRC32}

Standard CRC32 with reflected polynomial. No lookup table needed for the
small ROM files we are loading (a few KB each).

<<crc32 implementation>>=
uint32_t compute_crc32(const uint8_t* data, size_t length)
{
    uint32_t crc = 0xFFFFFFFF;
    for (size_t i = 0; i < length; i++) {
        crc ^= data[i];
        for (int bit = 0; bit < 8; bit++) {
            if (crc & 1)
                crc = (crc >> 1) ^ 0xEDB88320;
            else
                crc = crc >> 1;
        }
    }
    return ~crc;
}
@

\subsection{Address Space}

The constructor takes a name (for debug output) and an address mask. The
program space uses mask 0xFFFF (16-bit). The I/O space uses mask 0xFF
(8-bit), matching the Berzerk hardware which only decodes the low 8 bits
of the I/O address.

<<address space implementation>>=
AddressSpace::AddressSpace(const std::string& name, uint32_t addr_mask)
    : m_name(name)
    , m_addr_mask(addr_mask)
{
}

void AddressSpace::map(uint16_t start, uint16_t end,
                       ReadHandler read, WriteHandler write,
                       const std::string& region_name)
{
    m_regions.push_back({start, end, read, write, region_name});
}

void AddressSpace::map_rom(uint16_t start, uint16_t end,
                           ReadHandler read,
                           const std::string& region_name)
{
    auto nop_write = [](uint16_t, uint8_t) {};
    m_regions.push_back({start, end, read, nop_write, region_name});
}

void AddressSpace::map_unconnected(uint16_t start, uint16_t end,
                                   const std::string& region_name)
{
    auto ff_read = [](uint16_t) -> uint8_t { return 0xFF; };
    auto nop_write = [](uint16_t, uint8_t) {};
    m_regions.push_back({start, end, ff_read, nop_write, region_name});
}
@

Read and write dispatch to the matching region. If no region matches, the
access falls through to the unmapped default: reads return 0xFF, writes
are discarded. A diagnostic is printed on first unmapped access to aid
debugging.

<<address space implementation>>=
uint8_t AddressSpace::read(uint16_t addr) const
{
    addr &= m_addr_mask;
    m_read_count++;
    for (const auto& region : m_regions) {
        if (addr >= region.start && addr <= region.end) {
            return region.read(addr);
        }
    }
    std::fprintf(stderr, "[%s] unmapped read: 0x%04X\n", m_name.c_str(), addr);
    return 0xFF;
}

void AddressSpace::write(uint16_t addr, uint8_t data)
{
    addr &= m_addr_mask;
    m_write_count++;
    for (auto& region : m_regions) {
        if (addr >= region.start && addr <= region.end) {
            region.write(addr, data);
            return;
        }
    }
    std::fprintf(stderr, "[%s] unmapped write: 0x%04X = 0x%02X\n",
                 m_name.c_str(), addr, data);
}
@

\subsection{ROM Loader}

The loader takes a directory path, a list of ROM descriptors, and a
pre-sized byte vector. For each descriptor, it reads the file, verifies
its size and CRC32, and copies it into the byte vector at the specified
load address.

<<rom loader implementation>>=
bool load_roms(const std::string& rom_dir,
               const std::vector<RomDescriptor>& descriptors,
               std::vector<uint8_t>& rom_data,
               uint32_t rom_data_size)
{
    rom_data.assign(rom_data_size, 0xFF);

    for (const auto& desc : descriptors) {
        std::string path = rom_dir + "/" + desc.filename;
        std::ifstream file(path, std::ios::binary);
        if (!file.is_open()) {
            std::fprintf(stderr, "ROM load error: cannot open %s\n", path.c_str());
            return false;
        }

        std::vector<uint8_t> buf(desc.size);
        file.read(reinterpret_cast<char*>(buf.data()), desc.size);
        size_t bytes_read = file.gcount();

        if (bytes_read != desc.size) {
            std::fprintf(stderr, "ROM load error: %s expected %u bytes, got %zu\n",
                         desc.filename.c_str(), desc.size, bytes_read);
            return false;
        }

        uint32_t crc = compute_crc32(buf.data(), buf.size());
        if (crc != desc.crc32) {
            std::fprintf(stderr, "ROM CRC error: %s expected 0x%08X, got 0x%08X\n",
                         desc.filename.c_str(), desc.crc32, crc);
            return false;
        }

        if (desc.load_addr + desc.size > rom_data_size) {
            std::fprintf(stderr, "ROM load error: %s at 0x%04X overflows buffer\n",
                         desc.filename.c_str(), desc.load_addr);
            return false;
        }

        std::memcpy(&rom_data[desc.load_addr], buf.data(), buf.size());
        std::fprintf(stderr, "ROM loaded: %s at 0x%04X (%u bytes, CRC OK)\n",
                     desc.filename.c_str(), desc.load_addr, desc.size);
    }

    return true;
}
@

\section{Berzerk Memory Map Configuration}

This section defines the ROM table and a factory function that creates the
fully-configured program and I/O address spaces for the Berzerk machine.
All RAM arrays are now owned by [[BerzerkMemory]], and I/O handlers are
wired to the video, sound, and interrupt subsystems.

We put this in a separate source file so the memory subsystem itself remains
generic and reusable.

