\subsection{ROM Table}

The ROM descriptors for the RC31A revision, matching the files in
[[rom/berzerk/]]. These CRC32 values come directly from the MAME driver.

<<berzerk rom table>>=
static const std::vector<RomDescriptor> BERZERK_PROGRAM_ROMS = {
    {"berzerk_rc31_1c.rom0.1c",   0x0000, 0x0800, 0xca566dbc},
    {"berzerk_rc31_1d.rom1.1d",   0x1000, 0x0800, 0x7ba69fde},
    {"berzerk_rc31_3d.rom2.3d",   0x1800, 0x0800, 0xa1d5248b},
    {"berzerk_rc31_5d.rom3.5d",   0x2000, 0x0800, 0xfcaefa95},
    {"berzerk_rc31_6d.rom4.6d",   0x2800, 0x0800, 0x1e35b9a0},
    {"berzerk_rc31a_5c.rom5.5c",  0x3000, 0x0800, 0xe0fab8f5},
};

static const std::vector<RomDescriptor> BERZERK_VOICE_ROMS = {
    {"berzerk_r_vo_1c.1c",  0x0000, 0x0800, 0x2cfe825d},
    {"berzerk_r_vo_2c.2c",  0x0800, 0x0800, 0xd2b6324e},
};
@

\subsection{Address Space Setup}

All RAM (work RAM, video RAM, color RAM) is now owned by [[BerzerkMemory]].
The lambdas capture [[mem]] by reference so they access member fields
directly.  I/O handlers delegate to the video, sound, and interrupt
subsystem functions.

<<berzerk address space setup>>=
bool setup_berzerk_memory(BerzerkMemory& mem, const std::string& rom_dir)
{
    // Load program ROMs
    if (!load_roms(rom_dir, BERZERK_PROGRAM_ROMS,
                   mem.program_rom, 0x4000)) {
        return false;
    }

    // Load voice ROMs
    if (!load_roms(rom_dir + "/../berzerk", BERZERK_VOICE_ROMS,
                   mem.voice_rom, 0x1000)) {
        // Voice ROMs are not fatal -- game runs without speech
        std::fprintf(stderr, "Warning: voice ROMs not loaded, speech disabled\n");
        mem.voice_rom.assign(0x1000, 0xFF);
    }

    // Zero RAM owned by BerzerkMemory
    mem.work_ram.fill(0);
    // VideoState constructor already zeros vram and color_ram

    // Initialize sound with voice ROM pointer
    sound_reset(mem.sound, mem.voice_rom.data(),
                static_cast<uint32_t>(mem.voice_rom.size()));

    // -- Program space regions --

    // ROM0: 0x0000-0x07FF
    auto& prom = mem.program_rom;
    mem.program.map_rom(0x0000, 0x07FF,
        [&prom](uint16_t addr) -> uint8_t { return prom[addr]; },
        "ROM0");

    // Work RAM: 0x0800-0x0FFF (1KB at 0x0800, mirrored)
    mem.program.map(0x0800, 0x0FFF,
        [&mem](uint16_t addr) -> uint8_t {
            return mem.work_ram[addr & 0x03FF];
        },
        [&mem](uint16_t addr, uint8_t data) {
            mem.work_ram[addr & 0x03FF] = data;
        },
        "WorkRAM");

    // ROM1-ROM5: 0x1000-0x37FF
    mem.program.map_rom(0x1000, 0x37FF,
        [&prom](uint16_t addr) -> uint8_t { return prom[addr]; },
        "ROM1-5");

    // ROM6 unpopulated: 0x3800-0x3FFF (reads 0xFF)
    mem.program.map_unconnected(0x3800, 0x3FFF, "ROM6-empty");

    // Video RAM: 0x4000-0x5FFF (8KB)
    mem.program.map(0x4000, 0x5FFF,
        [&mem](uint16_t addr) -> uint8_t {
            return mem.video.vram[addr - 0x4000];
        },
        [&mem](uint16_t addr, uint8_t data) {
            mem.video.vram[addr - 0x4000] = data;
        },
        "VideoRAM");

    // Magic RAM: 0x6000-0x7FFF
    // Reads from VRAM at (addr - 0x6000). Writes go through 74181 ALU.
    mem.program.map(0x6000, 0x7FFF,
        [&mem](uint16_t addr) -> uint8_t {
            return mem.video.vram[addr - 0x6000];
        },
        [&mem](uint16_t addr, uint8_t data) {
            magic_ram_write(mem.video, addr - 0x6000, data);
        },
        "MagicRAM");

    // Color RAM: 0x8000-0xBFFF (2KB at 0x8000, mirrored)
    mem.program.map(0x8000, 0xBFFF,
        [&mem](uint16_t addr) -> uint8_t {
            return mem.video.color_ram[addr & 0x07FF];
        },
        [&mem](uint16_t addr, uint8_t data) {
            mem.video.color_ram[addr & 0x07FF] = data;
        },
        "ColorRAM");

    // Unmapped: 0xC000-0xFFFF
    mem.program.map_unconnected(0xC000, 0xFFFF, "unmapped-high");

    // -- I/O space regions --

    <<io sound ports>>
    <<io second sound board>>
    <<io input ports>>
    <<io video control ports>>
    <<io dip switches>>

    return true;
}
@

\subsection{I/O: Sound Ports (0x40--0x47)}

Ports 0x40--0x43, 0x45, 0x47 are Exidy 6840 timer registers.  Port 0x44
is the S14001A speech chip.  Port 0x46 is the SFX control latch.

<<io sound ports>>=
    // Exidy 6840 timer: 0x40-0x43, 0x45, 0x47
    // S14001A speech: 0x44
    // SFX latch: 0x46
    mem.io.map(0x40, 0x47,
        [&mem](uint16_t addr) -> uint8_t {
            uint8_t port = addr & 0xFF;
            if (port == 0x44) {
                return s14001a_read(mem.sound);
            }
            return exidy6840_read(mem.sound, port);
        },
        [&mem](uint16_t addr, uint8_t data) {
            uint8_t port = addr & 0xFF;
            if (port == 0x44) {
                s14001a_write(mem.sound, data);
            } else if (port == 0x46) {
                sfx_latch_write(mem.sound, data);
            } else {
                exidy6840_write(mem.sound, port, data);
            }
        },
        "Audio");
@

\subsection{I/O: Second Sound Board (0x50--0x57)}

Ports 0x50--0x57 are mapped to a second sound board connector on the
Berzerk PCB.  This board is initialized by the boot code but not used
in the standard game.  MAME maps them as no-op read/write.

<<io second sound board>>=
    mem.io.map(0x50, 0x57,
        [](uint16_t) -> uint8_t { return 0xFF; },
        [](uint16_t, uint8_t) {},
        "Sound2-unused");
@

\subsection{I/O: Input Ports (0x48--0x4A)}

These are read-only input ports.  All bits default to high (no buttons
pressed, active-low logic).

<<io input ports>>=
    mem.io.map_rom(0x48, 0x48,
        [&mem](uint16_t) -> uint8_t { return mem.input.port_48; },
        "P1-input");

    mem.io.map_rom(0x49, 0x49,
        [&mem](uint16_t) -> uint8_t { return mem.input.port_49; },
        "System-input");

    mem.io.map_rom(0x4A, 0x4A,
        [&mem](uint16_t) -> uint8_t {
            // Bit 7 = cabinet type: 1 = upright
            return mem.input.port_4a | 0x80;
        },
        "P2-input");
@

\subsection{I/O: Video and Interrupt Control (0x4B--0x4F)}

\begin{itemize}
\item \textbf{0x4B}: Magic RAM control register (write sets ALU config, clears
  shift latch, resets intercept flag).
\item \textbf{0x4C}: NMI enable.  Both read and write enable NMI.
\item \textbf{0x4D}: NMI disable.  Both read and write disable NMI.
\item \textbf{0x4E}: Read intercept flag (bit 7) and V256 (bit 0).
\item \textbf{0x4F}: IRQ enable.  Write bit 0: 1=enabled, 0=disabled.
\end{itemize}

<<io video control ports>>=
    // Magic RAM control: 0x4B (write only)
    mem.io.map(0x4B, 0x4B,
        [](uint16_t) -> uint8_t { return 0xFF; },
        [&mem](uint16_t, uint8_t data) {
            mem.video.magic.control = data;
            mem.video.magic.last_shift_data = 0;
            mem.video.magic.intercept = 1;
        },
        "MagicRAM-ctrl");

    // NMI enable: 0x4C (read and write both enable NMI)
    mem.io.map(0x4C, 0x4C,
        [&mem](uint16_t) -> uint8_t {
            mem.interrupts.nmi_enabled = true;
            return 0x00;
        },
        [&mem](uint16_t, uint8_t) {
            mem.interrupts.nmi_enabled = true;
        },
        "NMI-enable");

    // NMI disable: 0x4D (read and write both disable NMI)
    mem.io.map(0x4D, 0x4D,
        [&mem](uint16_t) -> uint8_t {
            mem.interrupts.nmi_enabled = false;
            return 0x00;
        },
        [&mem](uint16_t, uint8_t) {
            mem.interrupts.nmi_enabled = false;
        },
        "NMI-disable");

    // Intercept + V256: 0x4E (read only)
    mem.io.map_rom(0x4E, 0x4E,
        [&mem](uint16_t) -> uint8_t {
            return read_intercept(mem.video);
        },
        "Intercept");

    // IRQ enable: 0x4F (write only, bit 0)
    mem.io.map(0x4F, 0x4F,
        [](uint16_t) -> uint8_t { return 0xFF; },
        [&mem](uint16_t, uint8_t data) {
            mem.interrupts.irq_enabled = (data & 0x01) != 0;
        },
        "IRQ-ctrl");
@

\subsection{I/O: DIP Switches and LED (0x60--0x7F)}

Ports 0x60--0x67 are mirrored at +0x08, +0x10, +0x18.  DIP switch
values are returned as defaults (English language, standard coinage).

<<io dip switches>>=
    mem.io.map(0x60, 0x7F,
        [](uint16_t addr) -> uint8_t {
            switch (addr & 0x07) {
                case 0: return 0x00;  // F3: English, no test modes
                case 1: return 0xC0;  // F2: bonus 5000+10000
                case 2: return 0x00;  // F6: 1C/1C
                case 3: return 0x00;  // F5: 1C/1C
                case 4: return 0x00;  // F4: 1C/1C
                case 5: return 0x00;  // SW2
                case 6: return 0x00;  // LED off
                case 7: return 0x00;  // LED on
                default: return 0xFF;
            }
        },
        [](uint16_t, uint8_t) {},
        "DIP-LED");
@


