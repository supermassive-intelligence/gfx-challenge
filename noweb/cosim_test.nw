\subsection{RNG Test}

Verify the native RNG produces the same sequence as the Z80 code.
We run the emulator to the point where it seeds the RNG, then compare
sequences. Since the RNG is simple, we just verify the algorithm directly.

<<rng test>>=
int test_rng()
{
    std::fprintf(stderr, "=== RNG Test ===\n");
    int failures = 0;

    // The Z80 RNG at $2678: seed = seed * 7 + 0x3153
    // Test with known seed values
    struct TestCase {
        uint16_t seed;
        uint8_t expected_result;
        uint16_t expected_new_seed;
    };

    // Manually computed: seed=0x0000 -> 0*7+0x3153 = 0x3153, result = 0x31
    // seed=0x3153 -> 0x3153*7+0x3153 = 0x3153*8 = 0x18A98 & 0xFFFF = 0x8A98, result=0x8A
    // seed=0x0101 -> 0x0101*7+0x3153 = 0x0707+0x3153 = 0x385A, result=0x38
    TestCase cases[] = {
        {0x0000, 0x31, 0x3153},
        {0x3153, 0x8A, 0x8A98},
        {0x0101, 0x38, 0x385A},
    };

    for (const auto& tc : cases) {
        // Native implementation
        BerzerkNative native;
        native.state().rng_seed = tc.seed;
        uint8_t result = native.random();

        if (result != tc.expected_result) {
            std::fprintf(stderr, "  FAIL: seed=0x%04X expected=0x%02X got=0x%02X\n",
                         tc.seed, tc.expected_result, result);
            failures++;
        }
        if (native.state().rng_seed != tc.expected_new_seed) {
            std::fprintf(stderr, "  FAIL: seed=0x%04X expected_new=0x%04X got=0x%04X\n",
                         tc.seed, tc.expected_new_seed, native.state().rng_seed);
            failures++;
        }
    }

    std::fprintf(stderr, "RNG test: %s (%d failures)\n\n",
                 failures == 0 ? "PASS" : "FAIL", failures);
    return failures;
}
