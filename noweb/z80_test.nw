\subsection{Running a Test File}

Each JSON file contains an array of ~1000 test cases for one opcode.
We run all tests and report the pass/fail count.

<<run single test file>>=
struct TestResult {
    std::string filename;
    int total;
    int passed;
    int failed;
    std::string first_failure;
};

static TestResult run_test_file(const std::string& path)
{
    TestResult result;
    result.filename = std::filesystem::path(path).filename().string();
    result.total = 0;
    result.passed = 0;
    result.failed = 0;

    std::ifstream ifs(path);
    if (!ifs.is_open()) {
        result.first_failure = "cannot open file";
        return result;
    }

    json tests;
    try {
        tests = json::parse(ifs);
    } catch (const json::parse_error& e) {
        result.first_failure = std::string("JSON parse error: ") + e.what();
        return result;
    }

    AddressSpace prog = make_flat_program();
    AddressSpace io = make_flat_io();
    Z80 cpu(prog, io);

    std::vector<Mismatch> mismatches;

    for (const auto& test : tests) {
        result.total++;
        std::string test_name = test["name"].get<std::string>();

        // Load initial state
        load_state(cpu, test["initial"]);

        // Pre-load I/O port values for read operations
        std::memset(test_io, 0, sizeof(test_io));
        if (test.contains("ports")) {
            for (const auto& port_op : test["ports"]) {
                if (port_op[2].get<std::string>() == "r") {
                    uint16_t port_addr = port_op[0].get<uint16_t>();
                    uint8_t port_val = port_op[1].get<uint8_t>();
                    test_io[port_addr & 0xFF] = port_val;
                }
            }
        }

        // Execute exactly one instruction
        cpu.step();

        // Compare final state
        if (compare_state(cpu, test["final"], test_name, mismatches)) {
            result.passed++;
        } else {
            result.failed++;
            if (result.first_failure.empty()) {
                result.first_failure = test_name + ": ";
                for (size_t i = 0; i < mismatches.size() && i < 3; i++) {
                    if (i > 0) result.first_failure += ", ";
                    char buf[128];
                    std::snprintf(buf, sizeof(buf), "%s exp=0x%X got=0x%X",
                                  mismatches[i].field.c_str(),
                                  mismatches[i].expected,
                                  mismatches[i].actual);
                    result.first_failure += buf;
                }
                if (mismatches.size() > 3) {
                    char buf[32];
                    std::snprintf(buf, sizeof(buf), " (+%zu more)",
                                  mismatches.size() - 3);
                    result.first_failure += buf;
                }
            }
        }
    }

    return result;
}
@

\subsection{Main}

The test runner accepts either a directory of JSON files or individual
file paths. It runs each file and prints a summary.

<<test main>>=
int main(int argc, char* argv[])
{
    if (argc < 2) {
        std::fprintf(stderr, "Usage: %s <test-dir-or-file> [file...]\n", argv[0]);
        return EXIT_FAILURE;
    }

    std::vector<std::string> files;

    for (int i = 1; i < argc; i++) {
        std::filesystem::path p(argv[i]);
        if (std::filesystem::is_directory(p)) {
            for (const auto& entry : std::filesystem::directory_iterator(p)) {
                if (entry.path().extension() == ".json") {
                    files.push_back(entry.path().string());
                }
            }
        } else {
            files.push_back(argv[i]);
        }
    }

    std::sort(files.begin(), files.end());

    int total_files = 0;
    int total_pass = 0;
    int total_fail = 0;
    int files_clean = 0;
    int files_with_failures = 0;

    for (const auto& f : files) {
        TestResult r = run_test_file(f);
        total_files++;
        total_pass += r.passed;
        total_fail += r.failed;

        if (r.failed == 0) {
            files_clean++;
            std::fprintf(stdout, "PASS  %s (%d/%d)\n",
                         r.filename.c_str(), r.passed, r.total);
        } else {
            files_with_failures++;
            std::fprintf(stdout, "FAIL  %s (%d/%d passed, %d failed)  %s\n",
                         r.filename.c_str(), r.passed, r.total, r.failed,
                         r.first_failure.c_str());
        }
    }

    std::fprintf(stdout, "\n========================================\n");
    std::fprintf(stdout, "Files: %d tested, %d clean, %d with failures\n",
                 total_files, files_clean, files_with_failures);
    std::fprintf(stdout, "Tests: %d total, %d passed, %d failed\n",
                 total_pass + total_fail, total_pass, total_fail);
    std::fprintf(stdout, "========================================\n");

    return (total_fail == 0) ? EXIT_SUCCESS : EXIT_FAILURE;
}
