\subsection{Flat Memory}

The test suite needs a simple 64~KB memory with no mapping logic. We create
an [[AddressSpace]] backed by a flat byte array. I/O space is similarly flat
(256 bytes). Both support unrestricted read/write.

<<flat memory for tests>>=
static uint8_t test_mem[65536];
static uint8_t test_io[256];

static AddressSpace make_flat_program()
{
    AddressSpace as("test-program", 0xFFFF);
    std::memset(test_mem, 0, sizeof(test_mem));
    as.map(0x0000, 0xFFFF,
        [](uint16_t addr) -> uint8_t { return test_mem[addr]; },
        [](uint16_t addr, uint8_t data) { test_mem[addr] = data; },
        "flat-ram");
    return as;
}

static AddressSpace make_flat_io()
{
    AddressSpace as("test-io", 0xFF);
    std::memset(test_io, 0, sizeof(test_io));
    as.map(0x00, 0xFF,
        [](uint16_t addr) -> uint8_t { return test_io[addr & 0xFF]; },
        [](uint16_t addr, uint8_t data) { test_io[addr & 0xFF] = data; },
        "flat-io");
    return as;
}
@

\subsection{State Loader}

Load initial CPU and memory state from a JSON test object.

<<test state loader>>=
static void load_state(Z80& cpu, const json& state)
{
    cpu.set_pc(state["pc"].get<uint16_t>());
    cpu.set_sp(state["sp"].get<uint16_t>());

    uint8_t a = state["a"].get<uint8_t>();
    uint8_t f = state["f"].get<uint8_t>();
    cpu.set_af((a @<< 8) | f);

    uint8_t b = state["b"].get<uint8_t>();
    uint8_t c = state["c"].get<uint8_t>();
    cpu.set_bc((b @<< 8) | c);

    uint8_t d = state["d"].get<uint8_t>();
    uint8_t e = state["e"].get<uint8_t>();
    cpu.set_de((d @<< 8) | e);

    uint8_t h = state["h"].get<uint8_t>();
    uint8_t l = state["l"].get<uint8_t>();
    cpu.set_hl((h @<< 8) | l);

    cpu.set_ix(state["ix"].get<uint16_t>());
    cpu.set_iy(state["iy"].get<uint16_t>());
    cpu.set_wz(state["wz"].get<uint16_t>());

    cpu.set_af2(state["af_"].get<uint16_t>());
    cpu.set_bc2(state["bc_"].get<uint16_t>());
    cpu.set_de2(state["de_"].get<uint16_t>());
    cpu.set_hl2(state["hl_"].get<uint16_t>());

    cpu.set_i(state["i"].get<uint8_t>());
    cpu.set_r(state["r"].get<uint8_t>());

    cpu.set_iff1(state["iff1"].get<uint8_t>());
    cpu.set_iff2(state["iff2"].get<uint8_t>());
    cpu.set_im(state["im"].get<uint8_t>());

    cpu.set_halted(false);

    // Q register for SCF/CCF undocumented behavior
    cpu.set_q(state["q"].get<uint8_t>());

    // Load RAM contents
    std::memset(test_mem, 0, sizeof(test_mem));
    for (const auto& entry : state["ram"]) {
        uint16_t addr = entry[0].get<uint16_t>();
        uint8_t val = entry[1].get<uint8_t>();
        test_mem[addr] = val;
    }
}
@

\subsection{State Comparator}

Compare actual CPU and memory state against expected final state.
Returns true if all fields match. On mismatch, prints the first
difference found.

<<test state comparator>>=
struct Mismatch {
    std::string field;
    uint32_t expected;
    uint32_t actual;
};

static bool compare_state(Z80& cpu, const json& expected, const std::string& /*test_name*/,
                          std::vector<Mismatch>& mismatches)
{
    mismatches.clear();
    bool ok = true;

    auto check16 = [&](const char* name, uint16_t actual, uint16_t exp) {
        if (actual != exp) {
            mismatches.push_back({name, exp, actual});
            ok = false;
        }
    };

    auto check8 = [&](const char* name, uint8_t actual, uint8_t exp) {
        if (actual != exp) {
            mismatches.push_back({name, exp, actual});
            ok = false;
        }
    };

    check16("pc", cpu.get_pc(), expected["pc"].get<uint16_t>());
    check16("sp", cpu.get_sp(), expected["sp"].get<uint16_t>());

    uint8_t exp_a = expected["a"].get<uint8_t>();
    uint8_t exp_f = expected["f"].get<uint8_t>();
    check8("a", (cpu.get_af() >> 8) & 0xFF, exp_a);
    check8("f", cpu.get_af() & 0xFF, exp_f);

    uint8_t exp_b = expected["b"].get<uint8_t>();
    uint8_t exp_c = expected["c"].get<uint8_t>();
    check8("b", (cpu.get_bc() >> 8) & 0xFF, exp_b);
    check8("c", cpu.get_bc() & 0xFF, exp_c);

    uint8_t exp_d = expected["d"].get<uint8_t>();
    uint8_t exp_e = expected["e"].get<uint8_t>();
    check8("d", (cpu.get_de() >> 8) & 0xFF, exp_d);
    check8("e", cpu.get_de() & 0xFF, exp_e);

    uint8_t exp_h = expected["h"].get<uint8_t>();
    uint8_t exp_l = expected["l"].get<uint8_t>();
    check8("h", (cpu.get_hl() >> 8) & 0xFF, exp_h);
    check8("l", cpu.get_hl() & 0xFF, exp_l);

    check16("ix", cpu.get_ix(), expected["ix"].get<uint16_t>());
    check16("iy", cpu.get_iy(), expected["iy"].get<uint16_t>());
    check16("wz", cpu.get_wz(), expected["wz"].get<uint16_t>());

    check16("af'", cpu.get_af2(), expected["af_"].get<uint16_t>());
    check16("bc'", cpu.get_bc2(), expected["bc_"].get<uint16_t>());
    check16("de'", cpu.get_de2(), expected["de_"].get<uint16_t>());
    check16("hl'", cpu.get_hl2(), expected["hl_"].get<uint16_t>());

    check8("i", cpu.get_i(), expected["i"].get<uint8_t>());
    check8("r", cpu.get_r(), expected["r"].get<uint8_t>());

    check8("iff1", cpu.get_iff1(), expected["iff1"].get<uint8_t>());
    check8("iff2", cpu.get_iff2(), expected["iff2"].get<uint8_t>());
    check8("im", cpu.get_im(), expected["im"].get<uint8_t>());
    check8("q", cpu.get_q(), expected["q"].get<uint8_t>());

    // Check RAM
    for (const auto& entry : expected["ram"]) {
        uint16_t addr = entry[0].get<uint16_t>();
        uint8_t exp_val = entry[1].get<uint8_t>();
        uint8_t actual_val = test_mem[addr];
        if (actual_val != exp_val) {
            char buf[32];
            std::snprintf(buf, sizeof(buf), "ram[0x%04X]", addr);
            mismatches.push_back({buf, exp_val, actual_val});
            ok = false;
        }
    }

    return ok;
}
