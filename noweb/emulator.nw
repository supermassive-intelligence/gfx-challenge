\subsection{Event Logger}

<<event logger implementation>>=
void EventLogger::check_pc(uint16_t pc, uint16_t sp, bool interrupt_pending)
{
    if (!m_enabled || !m_entry_points) return;

    // Latch the interrupt flag for the next entry point hit.
    if (interrupt_pending) {
        m_interrupt_pending = true;
    }

    if (m_entry_points->check(pc)) {
        uint32_t& count = m_invocation_counts[pc];
        count++;

        InvocationRecord rec;
        rec.address = pc;
        rec.invocation_count = count;
        rec.trigger = m_interrupt_pending ?
            TriggerType::INTERRUPT : TriggerType::CONVENTIONAL;
        rec.stack_depth = sp;
        m_invocations.push_back(std::move(rec));

        // Only the ISR entry itself is tagged as interrupt-driven.
        // Subroutines called from within the ISR are conventional.
        m_interrupt_pending = false;
    }
}

void EventLogger::record_write(EventType type, EventRegion region,
                                uint16_t addr, uint8_t old_val, uint8_t new_val)
{
    if (!m_enabled) return;

    EventRecord ev;
    ev.type = type;
    ev.region = region;
    ev.address = addr;
    ev.old_data = old_val;
    ev.new_data = new_val;

    // Append to the most recent invocation, or discard if none open.
    if (!m_invocations.empty()) {
        m_invocations.back().events.push_back(ev);
    }
}

void EventLogger::record_collision(uint8_t old_val, uint8_t new_val)
{
    if (!m_enabled) return;

    EventRecord ev;
    ev.type = EventType::COLLISION_CHANGE;
    ev.region = EventRegion::OTHER;
    ev.address = 0;
    ev.old_data = old_val;
    ev.new_data = new_val;

    if (!m_invocations.empty()) {
        m_invocations.back().events.push_back(ev);
    }
}

FrameLog EventLogger::finalize_frame(int frame_number,
                                      const uint8_t* vram, uint8_t intercept)
{
    FrameLog log;
    log.frame_number = frame_number;
    log.invocations = std::move(m_invocations);
    std::memcpy(log.final_vram.data(), vram, 0x2000);
    log.final_intercept = intercept;

    m_invocations.clear();
    return log;
}
@

\subsection{BerzerkEmulator}

<<berzerk emulator implementation>>=
BerzerkEmulator::BerzerkEmulator()
{
}

bool BerzerkEmulator::init(const char* rom_dir)
{
    if (!setup_berzerk_memory(m_mem, rom_dir)) {
        std::fprintf(stderr, "BerzerkEmulator: failed to initialize memory\n");
        return false;
    }

    m_cpu = std::make_unique<Z80>(m_mem.program, m_mem.io);

    // Try to load subroutine entry points for event logging.
    std::string ep_path = std::string(rom_dir) + "/../../cdoc/subroutine_entry_points.txt";
    if (load_entry_points(ep_path.c_str(), m_entry_points)) {
        m_logger.set_entry_points(&m_entry_points);
    }

    install_logging_handlers();
    m_frame_count = 0;
    return true;
}

void BerzerkEmulator::reset()
{
    if (m_cpu) m_cpu->reset();
    m_mem.work_ram.fill(0);
    m_mem.video.vram.fill(0);
    m_mem.video.color_ram.fill(0);
    m_frame_count = 0;
}

void BerzerkEmulator::step_frame()
{
    if (!m_cpu) return;

    // Check PC before each instruction for subroutine detection.
    // For non-logging mode, run_frame handles execution directly.
    if (m_logger.enabled()) {
        // Execute frame with per-instruction PC checking.
        m_mem.interrupts.irq_count = 0;
        m_mem.interrupts.nmi_count = 0;

        int cycles_done = 0;
        for (int i = 0; i < NUM_FRAME_EVENTS; i++) {
            const FrameEvent& ev = FRAME_EVENTS[i];
            while (cycles_done < ev.cycle_offset) {
                m_logger.check_pc(m_cpu->get_pc(), m_cpu->get_sp(), false);
                cycles_done += m_cpu->step();
            }
            m_mem.video.v256 = ev.v256;
            if (ev.type == IntType::NMI && m_mem.interrupts.nmi_enabled) {
                m_logger.check_pc(0x0066, m_cpu->get_sp(), true);
                m_cpu->nmi();
                m_mem.interrupts.nmi_count++;
            } else if (ev.type == IntType::IRQ && m_mem.interrupts.irq_enabled) {
                // IRQ handler address depends on IM mode; tag as interrupt
                m_logger.check_pc(m_cpu->get_pc(), m_cpu->get_sp(), true);
                m_cpu->irq(IRQ_VECTOR);
                m_mem.interrupts.irq_count++;
            }
        }
        while (cycles_done < CYCLES_PER_FRAME) {
            m_logger.check_pc(m_cpu->get_pc(), m_cpu->get_sp(), false);
            cycles_done += m_cpu->step();
        }
        m_mem.video.v256 = true;
    } else {
        run_frame(*m_cpu, m_mem.interrupts, m_mem.video);
    }

    m_frame_count++;
}

void BerzerkEmulator::step_instruction()
{
    if (!m_cpu) return;
    if (m_logger.enabled()) {
        m_logger.check_pc(m_cpu->get_pc(), m_cpu->get_sp(), false);
    }
    m_cpu->step();
}

MachineSnapshot BerzerkEmulator::snapshot() const
{
    MachineSnapshot snap;
    snap.cpu.af = m_cpu->get_af();
    snap.cpu.bc = m_cpu->get_bc();
    snap.cpu.de = m_cpu->get_de();
    snap.cpu.hl = m_cpu->get_hl();
    snap.cpu.af2 = m_cpu->get_af2();
    snap.cpu.bc2 = m_cpu->get_bc2();
    snap.cpu.de2 = m_cpu->get_de2();
    snap.cpu.hl2 = m_cpu->get_hl2();
    snap.cpu.ix = m_cpu->get_ix();
    snap.cpu.iy = m_cpu->get_iy();
    snap.cpu.sp = m_cpu->get_sp();
    snap.cpu.pc = m_cpu->get_pc();
    snap.cpu.wz = m_cpu->get_wz();
    snap.cpu.i = m_cpu->get_i();
    snap.cpu.r = m_cpu->get_r();
    snap.cpu.iff1 = m_cpu->get_iff1();
    snap.cpu.iff2 = m_cpu->get_iff2();
    snap.cpu.im = m_cpu->get_im();
    snap.cpu.halted = m_cpu->get_halted();

    snap.work_ram = m_mem.work_ram;
    snap.vram = m_mem.video.vram;
    snap.color_ram = m_mem.video.color_ram;
    snap.magic_control = m_mem.video.magic.control;
    snap.magic_intercept = m_mem.video.magic.intercept;
    snap.nmi_enabled = m_mem.interrupts.nmi_enabled;
    snap.irq_enabled = m_mem.interrupts.irq_enabled;
    snap.frame_number = m_frame_count;

    return snap;
}

void BerzerkEmulator::restore(const MachineSnapshot& snap)
{
    m_cpu->set_af(snap.cpu.af);
    m_cpu->set_bc(snap.cpu.bc);
    m_cpu->set_de(snap.cpu.de);
    m_cpu->set_hl(snap.cpu.hl);
    m_cpu->set_af2(snap.cpu.af2);
    m_cpu->set_bc2(snap.cpu.bc2);
    m_cpu->set_de2(snap.cpu.de2);
    m_cpu->set_hl2(snap.cpu.hl2);
    m_cpu->set_ix(snap.cpu.ix);
    m_cpu->set_iy(snap.cpu.iy);
    m_cpu->set_sp(snap.cpu.sp);
    m_cpu->set_pc(snap.cpu.pc);
    m_cpu->set_wz(snap.cpu.wz);
    m_cpu->set_i(snap.cpu.i);
    m_cpu->set_r(snap.cpu.r);
    m_cpu->set_iff1(snap.cpu.iff1);
    m_cpu->set_iff2(snap.cpu.iff2);
    m_cpu->set_im(snap.cpu.im);
    m_cpu->set_halted(snap.cpu.halted);

    m_mem.work_ram = snap.work_ram;
    m_mem.video.vram = snap.vram;
    m_mem.video.color_ram = snap.color_ram;
    m_mem.video.magic.control = snap.magic_control;
    m_mem.video.magic.intercept = snap.magic_intercept;
    m_mem.interrupts.nmi_enabled = snap.nmi_enabled;
    m_mem.interrupts.irq_enabled = snap.irq_enabled;
    m_frame_count = snap.frame_number;
}

const uint8_t* BerzerkEmulator::vram_data() const
{
    return m_mem.video.vram.data();
}

void BerzerkEmulator::set_input(const InputState& input)
{
    m_mem.input = input;
}

void BerzerkEmulator::set_logging_enabled(bool enabled)
{
    m_logger.set_enabled(enabled);
}

FrameLog BerzerkEmulator::take_frame_log()
{
    return m_logger.finalize_frame(
        m_frame_count,
        m_mem.video.vram.data(),
        m_mem.video.magic.intercept);
}

int BerzerkEmulator::frame_count() const
{
    return m_frame_count;
}
