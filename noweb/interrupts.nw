\subsection{Frame Execution}

For each event in the sorted table, we run the CPU up to the event's cycle
offset, then fire the interrupt if enabled.  After all events, we run the
remaining cycles to complete the frame.

The execute function may overshoot the requested cycle count (it finishes
the current instruction).  We track the actual cycle count and adjust
subsequent chunks accordingly.

<<run frame implementation>>=
int run_frame(Z80& cpu, InterruptState& ints, VideoState& video)
{
    ints.irq_count = 0;
    ints.nmi_count = 0;

    int cycles_done = 0;

    for (int i = 0; i < NUM_FRAME_EVENTS; i++) {
        const FrameEvent& ev = FRAME_EVENTS[i];

        // Run CPU up to this event's cycle position
        int target = ev.cycle_offset;
        if (cycles_done < target) {
            cycles_done += cpu.execute(target - cycles_done);
        }

        // Update V256 for port 0x4E reads
        video.v256 = ev.v256;

        // Fire interrupt if enabled
        if (ev.type == IntType::NMI) {
            if (ints.nmi_enabled) {
                cpu.nmi();
                ints.nmi_count++;
            }
        } else {
            if (ints.irq_enabled) {
                cpu.irq(IRQ_VECTOR);
                ints.irq_count++;
            }
        }
    }

    // Run remaining cycles to complete the frame
    if (cycles_done < CYCLES_PER_FRAME) {
        cycles_done += cpu.execute(CYCLES_PER_FRAME - cycles_done);
    }

    // After all events, we are in vblank region
    video.v256 = true;

    return cycles_done;
}
