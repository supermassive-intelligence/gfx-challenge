FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    noweb \
    libsdl2-dev \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY noweb/ noweb/
COPY Makefile .
COPY scripts/start-novnc.sh scripts/

RUN make tangle && make build

EXPOSE 6080

CMD ["scripts/start-novnc.sh"]
